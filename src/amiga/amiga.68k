	.align 2

* 32 rows = 256 pixels
* table of the colors for fg tiles in the copperlist
	.set	row_offset,0
bg_color_table:
	.rept	14
	.long	color_row_0+row_offset
	* warning: this offset increase depends on what's in color_row_0
	* 16=4 colors to change, 32 bytes per star pattern * 8 patterns per row
	.set	row_offset,row_offset+copper_8x8_row_size
	.endr
	.set	row_offset,0
	.rept	14
	.long	color_row_14+row_offset
	* warning: this offset increase depends on what's in color_row_0
	* 16=4 colors to change, 32 bytes per star pattern * 8 patterns per row
	.set	row_offset,row_offset+copper_8x8_row_size
	.endr
	.long	color_row_28
	.long	color_row_29

	* special cases, we have to hack colors at some point
	* so NAMCO logo is really red, else it remains white.
	
	.long	color_row_30
	.long	color_row_31
	.long	color_row_32
	.long	color_row_33
	.long	color_row_34



