*
*	Amiga-specific portions of galaga
*
* (c) JOTD 2024
*
* Rendering layer rewritten from scratch (2026):
*
* - bob planes (0-3) are INTERLEAVED (row = p0 p1 p2 p3, 160 bytes) so a whole
*   4-plane bob is ONE blit (erase: 1 D-only blit, draw: 1 ABCD blit)
* - char plane (plane 4) is a separate, single (shared) buffer. The blitter never
*   touches it, so erasing bobs never damages text
* - bob blits are queued by the CPU and executed by a blitter-interrupt chain:
*   the CPU never waits for the blitter
* - game logic (galaga_irq) runs in a level 1 (SOFTINT) job, triggered by the
*   copper interrupt, so the level 3 blitter interrupt can preempt it
* - the "2 bitplanes for small aliens" hack is kept: bobs with 1 or 2 non-empty
*   planes (and y-flipped bobs) are drawn plane by plane, empty planes are
*   skipped. Very short blits are chained "inline" (handler spins) instead of
*   costing one interrupt each
* - 3 and 4-plane bobs are converted once at startup to an interleaved
*   format (from the unchanged graphics.68k data)
*

.include "../src/galaga.inc"
.include "../src/structs.inc"
.include "../src/variables.inc"
.include "custom.i"
.include "exec_lvos.i"
.include "dos_lvos.i"
.include "graphics_lvos.i"

AttnFlags = 0x128
AFB_68010 = 0
AFB_68020 = 1
NO68020 = 1


SPRITE_Y_CORRECTION = -8
SPRITE_X_CORRECTION = 8
HW_SPRITE_X_CORRECTION = 0
HW_SPRITE_Y_CORRECTION = -2

LOOP_CHANNEL = 3

BASE_BPLCON2_VALUE = 0x0000   | sprites behind
SCREEN_ADDRESS = 0x8000

* dynamic color change + stars lifted from my previous Galaxian port
STAR_SPRITE_INDEX = 7
STAR_SPRITE_COLOR_REG = color+(STAR_SPRITE_INDEX/2)*8+34

copper_stars_offset = 12
copper_row_size = 32
copper_8x8_row_size = copper_stars_offset+copper_row_size*8

HFIRSTROW = 0x1C

MAX_ROW_X = 31

BORDERBLANK = 0
SCORE_FILE_SIZE = 9*5

* sprite RAM layout (game side)

SPRITE_BLOCK_OFFSET = 0x9300-0x8B00			| len of each sprite info table times 2
CURRENT_SPRITE_SIZE = 2

TARGET_SPRITE_ATTRIBUTES = SPRITE_BLOCK_OFFSET*2
TARGET_SPRITE_X_1 = 1+SPRITE_BLOCK_OFFSET
TARGET_SPRITE_X_2 = 1+TARGET_SPRITE_ATTRIBUTES
TARGET_SPRITE_COLOR = 1
TARGET_SPRITE_CODE = 0
TARGET_SPRITE_Y = SPRITE_BLOCK_OFFSET

DOUBLE_SHOT_CODE = 0x7F

	.ifdef	RELEASE
OPT_ENABLE_PROFILING = 0         | DO NOT CHANGE THIS
OPT_ENABLE_LOGGING = 0           | DO NOT CHANGE THIS
ONE_TICK = 1
	.else
OPT_ENABLE_LOGGING = 0
OPT_ENABLE_PROFILING = 0
* set to higher values than 1 to speed game up
ONE_TICK = 1
	.endif


_custom = 0xDFF000

*----------------------------------------------------------------------------
* screen layout
*----------------------------------------------------------------------------

NB_PLAYFIELD_PLANES = 5
NB_BOBS_PLANES = 4
TOTAL_NB_COLORS = 1<<NB_BOBS_PLANES
NB_BYTES_PER_ROW = 40
NB_ROWS = 36
NB_LINES = NB_ROWS*8  | 288
Y_MAX = NB_LINES

* one "row" of the interleaved bob screen: p0 p1 p2 p3 (40 bytes each)
ILV_STRIDE = NB_BYTES_PER_ROW*NB_BOBS_PLANES		| 160
* 32 extra lines as bobs can be drawn below the limit (which happens!)
BOB_SCREEN_LINES = NB_LINES+32
BOB_SCREEN_SIZE = ILV_STRIDE*BOB_SCREEN_LINES
* char plane is fetched with the same modulo (BPL1MOD is shared by
* BPL1/3/5) so it has the same 160 byte stride, only 40 bytes used per line
CHAR_PLANE_LINES = NB_LINES+8
CHAR_PLANE_SIZE = ILV_STRIDE*CHAR_PLANE_LINES
BPL_MODULO = ILV_STRIDE-NB_BYTES_PER_ROW		| 120

* 3 and 4-plane bobs converted to interleaved format at startup
* (61776 bytes needed with current graphics). Items are first placed in the
* unused part of the char plane lines (bytes 40-159, ~30KB), the rest goes
* in this pool (31360 bytes needed). If it doesn't fit, the remaining bobs
* are just drawn plane by plane
ILV_POOL_SIZE = 32768
CHAR_GAP_OFFSET = NB_BYTES_PER_ROW			| 40 (AGA overfetch reads 40-47: harmless)
CHAR_GAP_SIZE = ILV_STRIDE-NB_BYTES_PER_ROW	| 120
ILV_MIN_PLANES = 3			| bobs with less planes are blitted plane by plane
MAX_BOB_RECORDS = 512		| 472 needed with current graphics
MASK_CACHE_SIZE = 256
NB_BOB_CODES = 128
NB_CLUTS = 16

* only 4 hardware sprites used
NB_HOST_SPRITES = 4

* hardware can take 64 sprites max like Xevious. What a beast for 1981!

NB_TARGET_SPRITES = 64

* for host sprites
SPRITE_X = 0
SPRITE_Y = 1
SPRITE_CODE = 2
SPRITE_CLUT = 3
SPRITE_SIZEOF = 4

*----------------------------------------------------------------------------
* interrupts
*----------------------------------------------------------------------------

IRQ_SET = 0x8000
IRQ_MASTER = 0x4000
IRQ_SOFT = 0x0004		| level 1: game job
IRQ_PORTS = 0x0008		| level 2: keyboard
IRQ_COPER = 0x0010		| level 3: frame timing
IRQ_VERTB = 0x0020		| level 3: joystick, music
IRQ_BLIT = 0x0040		| level 3: blit chain

* game ticks that can pile up if the CPU is too slow (avoids a death spiral)
MAX_PENDING_TICKS = 2

* frame (back buffer) states
FS_FREE = 0			| back buffer can be drawn
FS_BUSY = 1			| blit chain building/running into the back buffer
FS_READY = 2		| back buffer complete, waiting for bottom of frame to be shown

*----------------------------------------------------------------------------
* blitter queue
*----------------------------------------------------------------------------

* a queue entry starts with a routine pointer (executed by the blitter
* interrupt), followed by its data:
*
* r_setup:  .l bltcon0/1 .l afwm/alwm .w cmod,bmod,amod,dmod  (no blit started)
* r_clear:  .l D                    .w bltsize   (D only)
* r_cookie: .l bltcon0/1 .l C,B,A,D .w bltsize   (ABCD cookie cut)
*
* *_spin variants: the blit is short (shorter than an interrupt round trip),
* so the handler waits for it and goes on with the next entry immediately

* a blit shorter than that (in DMA cycles) is chained inline (tunable)
* an interrupt round trip costs ~400 CPU cycles = ~200 DMA cycles on a 68000
SPIN_DMA_CYCLES = 200

* worst case: 64 erases (+2 setups) + 64 draws * 4 planes (+setups) < 10000
BLIT_QUEUE_SIZE = 12000

* setup keys (index in setup_table)
SETUP_CLEAR = 0			| +nwords-1   (1,2)
SETUP_ILV = 1			| +nwords     (3,4)
SETUP_PLANE = 3			| +nwords     (5,6)
SETUP_PLANE_FLIP = 5	| +nwords     (7,8)

*----------------------------------------------------------------------------
* structures
*----------------------------------------------------------------------------

* bob render record, built at startup from graphics.68k block headers
BR_FLAGS = 0			| .b bit BRF_ILV: interleaved data available
BR_NWORDS = 1			| .b blit width in words (2: 16 pixels, 3: 32 pixels)
BR_HEIGHT = 2			| .w
BR_YOFF = 4				| .w
BR_YREV = 6				| .w y offset when flipped
BR_ILVDATA = 8			| .l interleaved data (4 planes, no shift padding)
BR_ILVMASK = 12			| .l interleaved mask (mask x 4)
BR_MASK = 16			| .l original mask
BR_PLANES = 20			| 4.l original planes (0: empty plane)
BR_SIZEOF = 36

BRF_ILV = 0

* graphics.68k block: .w height,yoff,yrev  .l p0,p1,p2,p3,mask  then mirrored block
GB_PLANES = 6
GB_MASK = 6+4*NB_BOBS_PLANES
GB_SIZEOF = 6+4*(NB_BOBS_PLANES+1)

* decoded current sprite (snapshot of sprite RAM)
CS_XY = 0				| .w x .w y (x=0: not a bob)
CS_CCA = 4				| .l code, color, attributes, 0 (compared as a long)
CS_CODE = 4
CS_COLOR = 5
CS_ATTR = 6
CS_SIZEOF = 8

* what was drawn in a given buffer for a given sprite slot
DL_XY = 0				| same 8 bytes as CS so they can be compared
DL_CCA = 4
DL_DOFF = 8				| .l top left (clipped) offset in screen
DL_ESIZE = 12			| .w erase bltsize (4 planes)
DL_NWORDS = 14			| .b 0: nothing drawn
DL_SBAR = 15			| .b bit 0/1: overlaps left/right part of status bar, bit 7: short erase
DL_SIZEOF = 16

* status bar (2 bottom rows) parts that bobs can overwrite (planes 2 & 3 tiles)
SBAR_TOP_LINE = 33*8-3		| rows 33 & 34 are drawn 3 lines higher
SBAR_LEFT_END = 13*8		| tile columns 1-12 (ships)
SBAR_RIGHT_START = 19*8		| tile columns 19-30 (level flags)
SBAR_LEFT = 0
SBAR_RIGHT = 1
SBAR_SHORT_ERASE = 7

MAX_DEFERRED_TILES = 64

| write current PC value to some address
.macro LOGPC	address
	.ifndef	RELEASE
     bsr    .next_\@
.next_\@:
      addq.l    #6,(a7) | skip this & next instruction
      move.l    (a7)+,0x\address
	.endif
.endm

* blitter high priority or "nasty"
* (not used by the renderer anymore, kept for debug purposes)

.macro	WAIT_BLIT
	move.w	#0x8400,(dmacon,a5)		| blitter high priority
wait\@:
	BTST	#6,(dmaconr,a5)
	BNE.S	wait\@
	move.w	#0x0400,(dmacon,a5)		| blitter normal priority
.endm

.macro MUL_TABLE value,len
mul\value\()_table:
	.set    mulv,0
	.rept	\len
	dc.w	mulv
	.set	mulv,mulv+\value
	.endr
.endm

* critical section usable from user mode (game main loop runs in user mode
* when started from DOS, so SR can't be touched there). Only code that is
* never called with the master bit already cleared may use this.
.macro	DISABLE_INTS
	move.w	#IRQ_MASTER,_custom+intena
	tst.w	_custom+intenar		| make sure the write has landed (040/060)
.endm

.macro	ENABLE_INTS
	move.w	#IRQ_SET+IRQ_MASTER,_custom+intena
.endm

* make the entries written at A4 visible to the blitter interrupt,
* and start the chain if the blitter is idle
.macro	PUBLISH
	move.l	a4,blitq_wr
	tst.b	blit_idle
	jeq		nokick\@
	jbsr	blitq_kick
nokick\@:
.endm

* debug macro that colors the screen until LMB pressed
.macro 	blitz_bypass
	move.w	d0,-(a7)
	clr.w	d0
loop\@:
	move.w	d0,_custom+color
	btst	#6,0xbfe001
	beq.b	out\@
	addq.w	#1,d0
	bra.b	loop\@
out\@:
	move.w	(a7)+,d0
	nop
.endm

* same thing but if LMB is pressed when entering, macro waits for release)
.macro blitz
w\@:
	btst	#6,0xbfe001
	beq.b	w\@
	blitz_bypass
.endm

start:
	move.l	a7,old_stack
	bra	_user
    
	

* exports

	  .global _user
		.global _player_start
		.global _demo_end

* osd layer		
		.global osd_interrupt_control
		.global osd_ack_vblank_interrupt
		.global osd_break		| for debug	
		.global osd_blitz		| for debug
		.global osd_w_videoram_no_update
		.global osd_w_videoram
		.global osd_w_colorram
		.global osd_update_inputs
		.global osd_get_random
		.global osd_read_dsw_1
		.global osd_read_dsw_2
		.global osd_read_dsw_3
		.global osd_read_dsw_4
		.global osd_read_dsw_5
		.global osd_read_dsw_6
		.global osd_read_nb_fighters
		.global osd_read_in_2
		.global osd_read_in_0
		.global osd_read_high_scores
		.global osd_write_high_scores
		.global osd_sound_start
		.global osd_sound_stop
		.global osd_loop_stop
		.global	osd_update_palette_bank
		.global	osd_wait

	
	.include	"ReadJoypad.i"
	.include	"whdload_funcs.i"
		.text


.list

	.ifne	OPT_ENABLE_PROFILING
	* init profiling if enabled
	.include	"profiler.68k"
	.endif

	    
_user:
    * if D0 contains "WHDL"
    * A0 contains resload
        
    cmp.l   #0x05748444c,D0	| WHDL
    bne.b   .standard
	move.b	d1,_keyexit
    move.l a0,_resload

	move.l	a0,a2
	lea	(_tag,pc),a0
	jsr	(resload_Control,a2)
	
	* resolve indirection for start level (better on command line: all levels can be selected)
	lea		start_levels_whd(pc),a0
	move.l	start_level_option,d0
	and.w	#0x3F,d0
	move.b	(a0,d0.w),d0
	subq	#1,d0		| zero indexed after all!
	move.b	d0,start_level_option+3
	
    bra		.no_forbid
.standard:
	
    * open dos library, graphics library
    move.l  0x4.W,a6
    lea dosname,a1
    moveq.l #0,d0
    jsr _LVOOpenLibrary(a6)
    move.l  d0,_dosbase

	lea	read_args_string(pc),a0
	lea	program_args(pc),a1
	move.l	#program_args_end-program_args,d0
	lsr.l	#2,d0		| number of longs
	

	bsr	get_args_BCPL
0:	
	lea		program_args,a0

	move.l	(A0)+,D0	| INVINCIBLE/S
	beq.b	1f
	or.l	#1,cheat_flags
	st.b	cheat_used
1:
	move.l	(A0)+,D0	| INFLIVES/S
	beq.b	2f
	or.l	#2,cheat_flags
	st.b	cheat_used
2:
	move.l	(A0)+,D0	| PERFECT/S
	beq.b	2f
	or.l	#4,cheat_flags
	st.b	cheat_used
2:
	move.l	(A0)+,D0	| CHEATKEYS/S
	beq.b	2f
	* cheat isn't used as long as no cheat key is used
	or.l	#0x10,cheat_flags
2:
	move.l	(A0)+,D0	| STATICSTARS/S
	beq.b	2f
	or.l	#2,misc_options
2:
	move.l	(A0)+,D0	| FORCE25FPS/S
	beq.b	2f
	move.l	#1,frameskip
2:
	move.l	(A0)+,D0	| FORCE17FPS/S
	beq.b	2f
	move.l	#2,frameskip
2:


	move.l	(A0)+,D0	| STARTLIVES/S
	beq.b	2f
	bsr		bcpl_string_to_int
	subq.b	#3,d0
	bmi.b	2f
	move.l	d0,dip_switch_start_lives
	bra.b	3f
2:
	move.l	#0,dip_switch_start_lives		| 3 lives default
3:
	move.l	(A0)+,D0		| STARTLEVEL/K/N
	beq.b	2f
	bsr		bcpl_string_to_int
	subq	#1,d0
	move.l	d0,start_level_option
2:
	lea		_custom,a5
	lea		debug_copperlist,a0
	move.l	a0,cop1lc(a5)

	move.l	4.W,A6
	lea graphicsname,a1
    moveq.l #0,d0
    jsr _LVOOpenLibrary(a6)
    move.l  d0,_gfxbase
    move.l	d0,a6
	move.l	38(a6),old_syscoplist
	move.l	34(A6),old_actiview		| gb_ActiView

	sub.l	a1,a1
	jsr	_LVOLoadView(a6)
	jsr	_LVOWaitTOF(a6)
	jsr	_LVOWaitTOF(a6)

	bsr		load_highscores

    * check if "floppy" file is here
    
    move.l  _dosbase(pc),a6
    move.l   #floppy_file,d1
    move.l  #1005,d2   | MODE_OLDFILE
    jsr     _LVOOpen(a6)
    move.l  d0,d1
    beq.b   .no_floppy
    
    * "floppy" file found
    jsr     _LVOClose(a6)
    * wait 2 seconds for floppy drive to switch off
    move.l  #100,d1
    jsr     _LVODelay(a6)
.no_floppy:

.startup:

* no multitask
    tst.l   _resload
    bne.b   .no_forbid
    *move.l  _gfxbase(pc),a4
    *move.l StartList(a4),gfxbase_copperlist

	
    move.l  4,a6
    jsr _LVOForbid(a6)

    
	sub.l	A1,A1
	jsr	_LVOFindTask(a6)		| find ourselves
	move.l	D0,A0
	move.l	#-1,184(A0)	| pr_WindowPtr: no more system requesters (insert volume, write protected...)

.no_forbid:
	* align bitplanes
	lea		bob_screen_buffer_1,a0
	bsr		align_for_fmode
	move.l	a0,bob_back_screen
	lea		bob_screen_buffer_2,a0
	bsr		align_for_fmode
	move.l	a0,bob_front_screen
	lea		char_plane_buffer,a0
	bsr		align_for_fmode
	move.l	a0,char_plane_ptr
	



	moveq	#0,d0
	
	move.b	dip_switch_start_lives+3(pc),d0
	
*   bit 3 : \bonus at
*   bit 2 : / 00 = 7000  01 = 10000  10 = 15000  11 = 20000: leave to 0 (7000)
*   bit 1 : \ 00 = 3 lives  01 = 4 lives
*   bit 0 : / 10 = 5 lives  11 = 6 lives

	move.b	d0,dip_switches
	
	move.l	misc_options(pc),d1
	.ifndef	RELEASE
	btst	#31,d1
	sne		break_at_startup_flag
	.endif
	move.l	frameskip,d0
	addq	#1,D0
	move.b	d0,fps_divider

	btst	#1,d1
	sne		static_stars

	move.l	start_level_option,d0
	move.b	d0,start_level

	move.l	cheat_flags,d0
	btst	#0,d0
	sne		invincible_flag
	btst	#1,d0
	sne		infinite_lives_flag
	btst	#2,d0
	sne		perfect_challenge_stage_flag

	and.w	#7,d0
	sne		cheat_used

	jsr	 _detect_controller_types 

	bsr		load_palette_in_copperlist
	bsr		show_stars


	jra		demo_game


* < D0: bcpl string (with leading size byte)
* < A1: dest C string
bcpl_arg_string_copy:
    movem.l D0-D2/A0-A1,-(a7)
	lsl.l	#2,d0
	moveq.l	#0,d2
    move.l  d0,a0
	move.b	(a0)+,d2	| size
	beq.b	1f
	subq	#1,d2
0:
	move.b	(a0)+,(a1)+
	dbf		d2,0b
1:
    movem.l (a7)+,D0-D2/A0-A1
    rts


bcpl_string_to_int:
    movem.l A0/A1,-(a7)
    lea temp_filename_buffer(pc),a1
    bsr bcpl_arg_string_copy
    * convert to integer
    move.l  a1,a0
    * < A0: pointer on C string
    * > D0: value
    * > D1: -1 if ok, position of the string if error
    bsr parse_integer
    movem.l  (a7)+,a0/a1
	rts
	
* parse integer from string
* < A0: pointer on C string
* > D0: value
* > D1: -1 if ok, position of the string if error
parse_integer:
    movem.l  d2/d3,-(a7)
    * go to end of string
    moveq.l #-1,d1
.loop1:
    addq.l  #1,d1
    tst.b   (a0,d1.w)
    bne.b   .loop1
    * d1 is the number of chars
    moveq.l #0,d0
    moveq.l #0,d2
    subq.l  #2,d1   | 10th power minus 1
.loop2:
    move.b  (a0)+,d2
    beq.b   .out
    
    cmp.b   #32,d2
    beq.b   .skip
    sub.b   #48,d2
    bcs.b   .error
    cmp.b   #10,d2
    bcc.b   .error
    move.w  d1,d3
    bmi.b   .doadd
.muloop:
    mulu    #10,d2
    dbf d3,.muloop
.doadd:
    add.l   d2,d0
.skip:
    subq.l  #1,d1
    bra.b   .loop2
.out:    
    movem.l  (a7)+,d2/d3
    rts
.error:
    moveq.l #0,d0
    bra.b   .error
	
    * thanks Toni for this 1.3 read argument code
BCPL_RdArgs = 78
	
	* a1 = pointer to result array. Must be LONG aligned!
	* a0 = formatting string. BSTR!
	* d0 = size of result array (number of LONGs)
get_args_BCPL:
	movem.l d2/d3/d4,-(sp)
	move.l d0,d3
	moveq #BCPL_RdArgs,d0
	move.l a0,d1
	lsr.l #2,d1
	move.l a1,d2
	lsr.l #2,d2
	moveq #0,d4
	bsr.s call_bcpl
	movem.l (sp)+,d2/d3/d4
	rts

	* d0 = gv index
	* d1-d4 = bcpl parms

BCPL_STACK = 3000

call_bcpl:
	movem.l d2-d7/a2-a6,-(sp)

	move.l d0,d6
	move.l d1,d5

	move.l 4.w,a6
	move.l	_dosbase(pc),a5


	sub.l a1,a1
	jsr	_LVOFindTask(a6)
	move.l d0,a4

	* allocate BCPL stack
	move.l #BCPL_STACK,d0
	move.l #65536+1,d1
	jsr	_LVOAllocMem(a6)
	move.l d0,d7
	beq.s 0f
	
	movem.l d7/a5/a6,-(sp)

	moveq #0,d0
	move.l d5,d1
	sub.l a0,a0
	move.l d7,a1
	lea 3*4(a1),a1
	move.l 136(a4),a2
	lsl.w #2,d6
	move.l 0(a2,d6.w),a4
	movem.l 46(a5),a5/a6
	jsr (a5) | call bcpl!
	
	movem.l (sp)+,d7/a5/a6

0:
	move.l d7,a1
	move.l #BCPL_STACK,d0
	jsr	_LVOFreeMem(a6)


	movem.l (sp)+,d2-d7/a2-a6
	rts


NB_STAR_ROWS = 34		| height: 256

show_stars:
	move.l	a5,-(a7)
	lea	bg_color_table,a3
	lea	stars_palette_rgb4,a2
	lea	stars_copper_row_pointers(pc),a5
	
	clr.w	d7		| 8-row counter
	clr.w	d2		| palette index
2:
	* get address for the next 8 rows
	move.l	(a3)+,a1
	.ifndef RELEASE
	* sanity check
	cmp.w	#start_color,(a1)
	jeq		20f
	cmp.w	#0x1FE,(a1)
	jeq		20f
	jbsr	osd_break
20:
	.endif
	
	add.w	#copper_stars_offset,a1

	moveq	#8-1,d6
	cmp.w	#28,d7
	bne.b	3f
	moveq	#3-1,d6		| special row
3:
	move.l	a1,(a5)+
4:
	* pick random x
	bsr		random
	btst	#15,d0
	beq.b	1f	| 50% chance of displaying a star
	and.w	#0xFF,d0
	cmp.w	#240,d0		| empiric
	bcc.b	4b
	add.w	#6*8,d0	| add 48 offset because of screen centering
	move.w	#0,d1	| max Y, else glitchy stars
	move.l	a1,-(a7)
	lea		HW_SpriteYTable_0,a1	
	bsr		store_sprite_pos
	move.l	(a7)+,a1
	* store color
	move.w	(a2,d2.w),(2,a1)		| change offset if copper sprite struct changes
	addq.w	#2,d2
	cmp.w	#128,d2		| 64 colors?
	bne.b	0f
	clr.w	d2			| wrap
0:

	* D0 is the sprite pos/control word
	move.w	d0,(10,a1)		| change offset if struct changes
	swap	d0
	move.w	d0,(6,a1)		| change offset if struct changes

	add.w	#32,a1
	dbf		d6,3b
	addq.w	#1,d7
	cmp.w	#NB_STAR_ROWS,d7
	jne		2b
	sub.l	#stars_copper_row_pointers,a5
	move.w	A5,d0
	lsr.w	#2,d0
	move.w	d0,stars_copper_pointers_count
	move.l	(a7)+,a5

	rts
1:
	clr.l	d0
	bra.b	0b
	
scroll_stars:
	tst.b	static_stars
	beq.b	0f
	rts
0:
	lea		stars_copper_row_pointers(pc),a5
	move.w	stars_copper_pointers_count(pc),d7
	move.w	d7,d6
	add.w	d6,d6
	add.w	d6,d6
	add.w	d6,a5		| point at the end of the row pointers
	subq.w	#1,d7
	* save last line first

	
	lea		temp_copper_buffer(pc),a3
	move.l	-(a5),a4
	move.w	(2,a4),(a3)+
	move.w	(10,a4),(a3)+
	move.w	(6,a4),(a3)
	subq	#1,d7
	* then overwrite each next line with previous one
0:
	move.l	(a5),a4	| destination
	move.l	-(a5),a3	| source
	move.w	(2,a3),(2,a4)
	move.w	(10,a3),(10,a4)
	move.w	(6,a3),(6,a4)

	dbf	d7,0b
	* restore last line into the first one
	move.l		stars_copper_row_pointers(pc),a4	| first item
	lea		temp_copper_buffer(pc),a3
	move.w	(a3)+,(2,a4)
	move.w	(a3)+,(10,a4)
	move.w	(a3),(6,a4)
	
	rts


	
random:
    move.l  previous_random(pc),d0
	* EAB simple random generator
    * thanks meynaf
    mulu #0xa57b,d0
    addi.l #0xbb40e62d,d0
    rol.l #6,d0
    move.l  d0,previous_random
    rts
	
	
	
get_hiscore_name:
    lea normal_hiscorename,a0
	rts
	
load_highscores:
	bsr.b		get_hiscore_name
    move.l  _resload(pc),d0
    bne.b   1f

    move.l  _dosbase(pc),a6
    move.l  a0,d1
    move.l  #1005,d2
    jsr     (_LVOOpen,a6)
    move.l  d0,d1
    beq.b   1f
    move.l  d1,d4
    move.l  #SCORE_FILE_SIZE,d3
    move.l  #high_score_buffer,d2
    jsr (_LVORead,a6)
    move.l  d4,d1
    jsr (_LVOClose,a6)   
	st.b	highscore_loaded
1:
    rts

save_highscores:
	tst.l	_resload
	bne.b	1f
    tst.b   highscore_needs_saving
    beq.b   1f
    move.l  _dosbase(pc),a6
	bsr.b		get_hiscore_name
    move.l  a0,d1
    move.l  #1006,d2
    jsr     (_LVOOpen,a6)
    move.l  d0,d1
    beq.b   1f
    move.l  d1,d4
    move.l  #SCORE_FILE_SIZE,d3
    move.l  #high_score_buffer,d2
    jsr (_LVOWrite,a6)
    move.l  d4,d1
    jsr (_LVOClose,a6)   
1:	
    rts
    
	
* To get the core to run, you just need to jump to galaga_reset after
* you've initialised the platform (Amiga) stuff. That essentially does a
* Z80 reset. You also need to call galaga_im1_irq from the Amiga vblank
* routine. They are the only 2 entry points required for the core to run,
* even if there's no other I/O.


demo_game:
		move		#0x4000,_custom+intena						| disable interrupts
		move		#0x7FFF,_custom+intreq						| ack all interrupts
		bsr			platform_init					| amiga-specific init
		
	
0:
	lea		ram_start_8000,a6


	* init video & color ram with improbable crap so attributes & video are forced
	* to refresh even when "0" is written into them
	move.w	#0x1FF,d1
	move.l	#-1,d0
	lea		o_bg_videoram_8000(a6),a0
0:
	move.l	d0,(a0)+
	dbf		d1,0b


	* resets both CPUs
	jbra		galaga_reset	| pass control to the galaga core
		
*============================================================================
* INTERRUPTS
*
* level 1 (SOFTINT): "game job" = game ticks + building the blit queue.
*                    Triggered by the copper interrupt, can be preempted by
*                    level 3, so the blitter chain runs while the game runs
* level 2 (PORTS):   keyboard (unchanged)
* level 3:           BLIT: next blit(s) of the chain (hot path, kept short)
*                    COPER: frame timing (mid-screen: 60Hz emulation tick,
*                           bottom: buffer swap + tick + render request)
*                    VERTB: joystick, music
*============================================================================

level3_interrupt:
	movem.l	d0-d1/a0-a1/a5,-(a7)
	lea		_custom,a5
	move.w	(intreqr,a5),d0
	btst	#6,d0				| blitter finished?
	jeq		1f
	move.w	#IRQ_BLIT,(intreq,a5)
	tst.b	blit_idle
	jne		0f					| no chain running: ignore
	tst.b	(dmaconr,a5)		| dummy read (early Agnus BBUSY quirk)
	btst	#6,(dmaconr,a5)
	jne		0f					| blitter still busy: spurious, ignore
	jbsr	blitq_run
0:
	move.w	(intreqr,a5),d0
1:
	and.w	#IRQ_COPER+IRQ_VERTB,d0
	jne		level3_slow_path
	movem.l	(a7)+,d0-d1/a0-a1/a5
	rte

level3_slow_path:
	movem.l	d2-d7/a2-a4/a6,-(a7)
	move.w	d0,-(a7)
	btst	#4,d0
	jeq		0f
	* ack twice (040/pistorm bug)
	move.w	#IRQ_COPER,(intreq,a5)
	move.w	#IRQ_COPER,(intreq,a5)
	jbsr	copper_interrupt
	lea		_custom,a5
0:
	move.w	(a7)+,d0
	btst	#5,d0
	jeq		1f
	move.w	#IRQ_VERTB,(intreq,a5)
	move.w	#IRQ_VERTB,(intreq,a5)
	jbsr	vblank_interrupt
1:
	movem.l	(a7)+,d2-d7/a2-a4/a6
	movem.l	(a7)+,d0-d1/a0-a1/a5
	rte

* < A5: custom
copper_interrupt:
	lea		ram_start_8000,a6
	btst	#0,(vposr+1,a5)		| V8 set: bottom of screen interrupt
	jne		bottom_of_screen_interrupt
	* mid-screen copper interrupt, adds a tick once every 5 times
	* to simulate ~60 Hz on 50 Hz display
	tst.b	pause_flag
	jne		0f
	addq.b	#1,mid_screen_interrupt_count
	cmp.b	#5,mid_screen_interrupt_count
	jne		0f
	clr.b	mid_screen_interrupt_count
	bsr		add_game_tick
0:
	rts

bottom_of_screen_interrupt:
	* show the back buffer if the blit chain has completed
	* (bitplane pointers are re-read by the copper at the top of next frame)
	cmp.b	#FS_READY,frame_state
	jne		0f
	jbsr	switch_screen_buffers
	move.b	#FS_FREE,frame_state
0:
	tst.b	pause_flag
	jne		2f
	bsr		add_game_tick
	st.b	hw_sprites_request
	move.b	flip_flop,d0
	addq.b	#1,d0
	cmp.b	fps_divider,d0
	jcs		1f
	* time to render a frame. If the back buffer is still busy,
	* the request just stays pending (frame skipped, game runs at full speed)
	.ifndef	RELEASE
	tst.b	render_request
	jeq		3f
	addq.l	#1,0xF4				| skipped frames counter
3:
	.endif
	st.b	render_request
	clr.b	d0
1:
	move.b	d0,flip_flop
2:
	rts

add_game_tick:
	cmp.b	#MAX_PENDING_TICKS,pending_ticks
	jcc		0f
	addq.b	#1,pending_ticks
0:
	move.w	#IRQ_SET+IRQ_SOFT,(intreq,a5)	| trigger level 1 job
	rts

vblank_interrupt:
	lea		ram_start_8000,a6

	move.l	_joypad_state(pc),d1
	moveq	#1,d0
	jsr	_read_joystick
	move.l	d0,_joypad_state

	* CD32 "play" is disabled but it's free to read
	* 3rd button on a Sega 3-button so 3rd button is pause
	btst	#JPB_BTN_PLAY,d0
	beq.b	0f
	btst	#JPB_BTN_PLAY,d1
	bne.b	0f
	bsr		toggle_pause
0:
	* here music doesn't loop. We have to stop it when it ends
	move.w	music_tick(pc),d1
	beq.b	13f

	subq	#1,d1

	.ifndef	RELEASE
	move.w	d1,0xF8
	.endif
	move.w	d1,music_tick
	bne.b	13f
	lea		playing_sounds(pc),a1
	move.b	(PERFECT_SND,a1),d2
	bsr		osd_sound_stop
	tst.b	d2
	jeq		13f
	* special case end of "PERFECT" play attack sound
	move.w	#ATTACK_SND,d0
	jbsr	osd_sound_start
13:
	rts

* level 1: game job
level1_interrupt:
	movem.l	d0-d7/a0-a6,-(a7)
	lea		_custom,a5
	move.w	#IRQ_SOFT,(intreq,a5)
	move.w	#IRQ_SOFT,(intreq,a5)
0:
	lea		ram_start_8000,a6
	tst.b	pending_ticks
	jeq		1f
	subq.b	#1,pending_ticks
	* declare that we're in interrupt mode so osd_disable_interrupts/osd_enable_interrupts
	* do nothing
	st.b	interrupt_mode
	jbsr	galaga_irq
	* galaga_irq could have changed SR, stay at level 1
	move.w	#0x2100,sr
	clr.b	interrupt_mode
	jra		0b
1:
	* hardware sprites updated once per frame, right after the
	* bottom-of-screen tick
	tst.b	hw_sprites_request
	jeq		2f
	clr.b	hw_sprites_request
	jbsr	update_hardware_sprites
2:
	tst.b	render_request
	jeq		3f
	tst.b	frame_state			| FS_FREE?
	jne		3f					| back buffer still in use: retry next frame
	clr.b	render_request
	jbsr	scroll_stars
	lea		ram_start_8000,a6
	jbsr	render_frame
3:
	movem.l	(a7)+,d0-d7/a0-a6
	rte

* just in case some hardware calls nmi
_nmi:
	move.w	#0x7FFF,_custom+intreq
	move.w	#0x7FFF,_custom+intreq
	rts
	

osd_blitz:
	blitz
	rts
	
osd_break:
	* sends a WinUAE command to enter WinUAE debugger
	.ifndef	RELEASE
	move.l	D0,-(a7)
	pea     0.w
	* Normally it would point to where the result of the command is written, but since the last parameter (first pushed)
	* indicating the number of bytes to write is 0, nothing is written.
	pea     0.w	
	pea     1003f-1002f
	pea     1002f(pc)
	pea     -1.w
	pea     82.w
	jsr     0xf0ff60
	lea     24(sp),sp
	move.l	(a7)+,d0
	.endif
    rts
		
1002: .asciz    "AKS_ENTERDEBUGGER 1"
1003:
        .align	
	


	


	
	
update_hardware_sprites:
	move.l	A6,-(a7)
	lea		o_sfr_sprite_code_8B80(a6),a0

	* clear host sprites
	moveq	#NB_HOST_SPRITES-1,d0
	
	lea		sprite_table,a4
	lea		host_sprites(pc),a2
0:
	clr.b	(SPRITE_X,a2)	| clear X is enough to know it's free
	st.b	(SPRITE_CLUT,a2) | invalid clut
	addq.w	#SPRITE_SIZEOF,a2
	dbf		d0,0b

	* check active sprites, we'll disable the sprites that aren't active anymore
	lea		hardware_sprite_flag_table,a5
	moveq	#NB_TARGET_SPRITES-1,d7
	moveq	#0,d2
1:
	* code = 0 and clut = 0 => disabled
	move.b	(TARGET_SPRITE_CODE,a0),d2
	
	tst.b	(a5,d2.w)		| is that a sprite
	beq.b	2f
	* -1 for ignored bobs
	bmi.b	2f

	* code to check if sprite exists/is "assembled" (feature introduced moon patrol)
*	moveq	#0,d3
*	move.w	d2,d4
*	bclr	#7,d4
*	add.w	d4,d4
*	add.w	d4,d4
*	tst.l	(a4,d4.w)	| test pointer
*	bmi.b	2f			| assembled: skip
*	beq.b	2f			| not a sprite: skip
	
	bsr		compute_sprite_xy
	tst		d0
	beq.b	2f			| X set to 0: not shown
	
	.ifne	HW_SPRITE_Y_CORRECTION
	add.w	#HW_SPRITE_Y_CORRECTION,d1
	.endif
	.ifne	HW_SPRITE_X_CORRECTION
	add.w	#HW_SPRITE_X_CORRECTION,d0
	.endif
	
	move.b	(TARGET_SPRITE_COLOR,a0),d3
	and.b	#0x0F,d3

	move.b	(TARGET_SPRITE_ATTRIBUTES,a0),d4
	btst	#1,d4		| clear & test X mirror mode (flipx, but screen is rotated)
	jeq		100f		
	bset	#7,d3		| we'll use mirrored sprite data
100:
	btst	#0,d4
	jeq		101f		
	bset	#6,d3	| means we'll use flipped data
101:
	

* < D2: sprite code & flags
* < D3: sprite color (clut index) plus flags
* > D6: allocated sprite index
* (also updates host_sprites table)
	* sprite active: allocate a sprite in host table
	* it HAS to succeed (it will as we only use a few sprites at the same time)
	bsr		alloc_sprite
	moveq	#0,d2
2:
	addq.w	#CURRENT_SPRITE_SIZE,a0
	dbf		d7,1b
	
	* all sprites are allocated: now display them
	lea		host_sprites(pc),a2		| input structure
	lea		sprites,a3				| copperlist
	moveq	#0,d6
10:
	move.b	(SPRITE_X,a2),d0
	bne.b	20f		
	* slot free: replace sprite by blank
	move.l	#blank_sprite,d4
	move.w	d4,(6,a3)
	swap	d4
	move.w	d4,(2,a3)
	jra		30f
20:
	* lookup sprite code
	
	and.w	#0xFF,d0
	moveq	#0,d1
	move.b	(SPRITE_Y,a2),d1
	moveq	#0,d2
	move.b	(SPRITE_CODE,a2),d2
	bclr	#7,d2
	sne		d5
	move.w	d2,d4
	add.w	d4,d4
	add.w	d4,d4
	move.l	(a4,d4.w),d4	| get pointer
*   filtering of BOBs & attached sprites has been done
*   above, let's trust the values to be valid
	bne.b	25f
	.ifdef	RELEASE
	jra		30f
	.else
	* sprite doesn't exist: blitz and bail out
	blitz
	move.b	d1,d1
	move.b	d2,d2
	.endif
	jra		30f
25:
	
	move.l	d4,a5
	move.w	d6,d4					| add sprite slot
	add.w	d4,d4
	add.w	d4,d4
	move.l	(a5,d4.W),a5			| get buffer for this sprite index
	* now a5 points to a table of 1-4 pointers of variously oriented sprite pics
	* for this slot
	* we'll add 0 to 12 to select the proper orientation depending on the attributes
	moveq	#0,d3
	move.b	(SPRITE_CLUT,a2),d3
	
	
	bclr	#6,d3
	beq.b	26f
	addq	#8,a5		| y flip
26:
	bclr	#7,d3
	beq.b	27f
	addq	#4,a5		| x mirror
27:
	move.l	(a5),d4
	jne		28f
	* orientation not available for that sprite
	move.b	(SPRITE_CLUT,a2),d3
	move.b	(SPRITE_CODE,a2),d2
	move.w	#0x0F0,_custom+color
	bra		30f
28:

	move.l	d4,a5

	.ifne	SPRITE_Y_CORRECTION
	add.w	#SPRITE_Y_CORRECTION,d1
	.endif
	.ifne	SPRITE_X_CORRECTION
	add.w	#SPRITE_X_CORRECTION,d0
	.endif	

	bsr		store_sprite_pos_16

	move.l	d0,(a5)
	* set colors
	lea		sprite_cluts+2,a6

	lsl.w	#3,d3		| clut times 8

	add.w	d3,a6
	* check if CLUT doesn't contain only color zero
	* (we may as well cache the values in spare registers)
	move.l	(a6)+,d3
	move.w	(a6)+,d7
*	bne.b	24f
*	tst.l	d3
*	bne.b	24f
*	* all black sprites would hide galaga sprites & tiles
*	* we want to hide them instead (no need to change palette)
*	* inherited from pengo, probably not required
*	move.l	#blank_sprite,d4
*	bra.b	25f
*24:
	move.l	a5,d4		| sprite pointer
	* d6 is the sprite index: compute/set proper color
	move.w	d6,d5
	bclr	#0,d5
	add.w	d5,d5
	add.w	d5,d5	| times 4
	move.w	d5,d2
	add.w	d2,d2
	lea		sprite_cols+6,a5	| sprite palette + 2 (first color skipped)
	add.w	d2,a5
	* copy 3 colors from cached registers into sprite color copperlist
	move.w	d3,(4,a5)
	swap	d3
	move.w	d3,(a5)
	move.w	d7,(8,a5)
25:
	* set sprite in copperlist
	move.w	d4,(6,a3)
	swap	d4
	move.w	d4,(2,a3)	
30:
	* next sprite
	addq.w	#8,a3		| advance in copperlist
	lea		(SPRITE_SIZEOF,a2),a2
	addq	#1,d6
	cmp.w	#NB_HOST_SPRITES,d6
	jne	10b
	move.l	(a7)+,a6
	rts
	
* < A0: sprite table
* > D0,D1: X,Y
compute_sprite_xy:
	moveq	#0,d0
	moveq	#0,d1
	move.b	(TARGET_SPRITE_X_1,a0),d0  | sprite X low (amiga Y)
	sub.w	#40,d0
	move.b	(TARGET_SPRITE_X_2,a0),d1
	and.b	#3,d1		| 3 seems not possible as X would be too big
	lsl.w	#8,d1		| times 0x100
	add.w	d1,d0
	jeq		2f
	jpl		3f
2:
	* one of the X,Y coord is zero: zero both and return
	* (makes amiga-side handling much easier)
	moveq	#0,d0
	moveq	#0,d1
	rts
	
3:
	moveq	#0,d1
	move.b	(TARGET_SPRITE_Y,a0),d1  | sprite Y
	jeq		2b
	tst		d1
	jmi		2b

	addq	#1,d1		| sprites are buffered and delayed by one scanline
	exg		d0,d1		| display is rotated 90 degrees!
	
	.ifndef	RELEASE
	cmp.w	#0x200,d0
	jcs		0f
	cmp.w	#0x200,d1
	jcs		0f
	move.l	#o_sfr_sprite_code_8B80,d0
	sub.l	a0,d0
	sub.l	a6,d0
	lea		coordinates_out_of_range_error(pc),a1
	jbsr	osd_break
	illegal
	
0:
	.endif
	
	rts
	
*============================================================================
* BOB RENDERER
*============================================================================

* builds the blit queue for the back buffer (level 1)
* the queue is published entry by entry, so the blitter starts working
* on the first erases while the CPU is still computing the next ones
*
* < A6: game RAM
* trashes everything

render_frame:
	move.b	#FS_BUSY,frame_state
	clr.b	producer_done
	clr.b	sbar_flags
	lea		blit_queue,a4
	move.l	a4,blitq_rd
	move.l	a4,blitq_wr
	st.b	blit_idle

	jbsr	decode_current_sprites
	moveq	#-1,d6				| current blitter setup: none
	jbsr	build_erase_list
	jbsr	build_draw_list

	.ifndef	RELEASE
	move.l	a4,d0
	sub.l	#blit_queue,d0
	move.l	d0,0xF0				| queue size in bytes
	.endif

	* done. If the chain has already drained (or was empty)
	* we have to declare completion ourselves
	move.w	sr,-(a7)
	or.w	#0x0700,sr
	st.b	producer_done
	tst.b	blit_idle
	jeq		0f
	lea		_custom,a5
	jbsr	blitq_run			| queue empty: just calls chain_complete
0:
	move.w	(a7)+,sr
	rts

* snapshot of the 64 game sprites into cur_sprites
* < A6: game RAM
decode_current_sprites:
	lea		o_sfr_sprite_code_8B80(a6),a0
	lea		cur_sprites,a3
	lea		hardware_sprite_flag_table,a2
	moveq	#NB_TARGET_SPRITES-1,d7
0:
	jbsr	compute_sprite_xy
	tst.w	d0
	jeq		2f					| not displayed
	moveq	#0,d2
	move.b	(TARGET_SPRITE_CODE,a0),d2
	bclr	#7,d2
	tst.b	(a2,d2.w)
	jne		2f					| hardware sprite: not a bob
	move.b	(TARGET_SPRITE_ATTRIBUTES,a0),d4
	cmp.b	#0x30,d2
	jne		1f
	btst	#3,d4
	jeq		1f
	moveq	#DOUBLE_SHOT_CODE,d2	| change sprite code (special case)
1:
	move.w	d0,(a3)+			| X
	move.w	d1,(a3)+			| Y
	move.b	d2,(a3)+			| code
	move.b	(TARGET_SPRITE_COLOR,a0),d3
	and.b	#0x3F,d3
	move.b	d3,(a3)+			| color
	and.b	#0x0B,d4			| y-flip, x-mirror, double
	move.b	d4,(a3)+			| attributes
	clr.b	(a3)+
	jra		3f
2:
	clr.l	(a3)+
	clr.l	(a3)+
3:
	addq.w	#CURRENT_SPRITE_SIZE,a0
	dbf		d7,0b
	rts

* erase what was drawn in the back buffer 2 frames ago:
* one D-only blit per bob, all 4 planes at once
* (skipped if the same bob is at the same place: it's going to be redrawn)
*
* < A4: queue write pointer
* < D6: current setup key
build_erase_list:
	move.l	bob_back_list(pc),a2
	lea		cur_sprites,a3
	move.l	bob_back_screen(pc),d5
	moveq	#NB_TARGET_SPRITES-1,d7
0:
	moveq	#0,d0
	move.b	(DL_NWORDS,a2),d0
	jeq		5f					| nothing drawn there
	move.l	(DL_XY,a2),d1
	cmp.l	(CS_XY,a3),d1
	jne		1f
	move.l	(DL_CCA,a2),d1
	cmp.l	(CS_CCA,a3),d1
	jeq		5f					| same bob/color/attributes at same place: skip erase
1:
	move.b	(DL_SBAR,a2),d1
	move.b	d1,d2
	and.b	#(1<<SBAR_LEFT)+(1<<SBAR_RIGHT),d2
	or.b	d2,sbar_flags		| erase damages status bar tiles: redraw them
	subq.w	#1,d0				| SETUP_CLEAR+nwords-1
	cmp.w	d0,d6
	jeq		2f
	move.w	d0,d6
	jbsr	emit_setup
2:
	lea		r_clear(pc),a0
	tst.b	d1					| bit 7: short erase
	jpl		3f
	lea		r_clear_spin(pc),a0
3:
	move.l	a0,(a4)+
	move.l	(DL_DOFF,a2),d1
	add.l	d5,d1
	move.l	d1,(a4)+			| D
	move.w	(DL_ESIZE,a2),(a4)+	| bltsize
	PUBLISH
5:
	lea		(DL_SIZEOF,a2),a2
	addq.w	#CS_SIZEOF,a3
	dbf		d7,0b
	rts

* draw the current bobs in the back buffer, and remember
* what was drawn (for the erase 2 frames later)
*
* < A4: queue write pointer
* < D6: current setup key
build_draw_list:
	move.l	bob_back_list(pc),a2
	lea		cur_sprites,a3
	moveq	#NB_TARGET_SPRITES-1,d7
0:
	move.l	(CS_XY,a3),(DL_XY,a2)
	move.l	(CS_CCA,a3),(DL_CCA,a2)
	clr.b	(DL_NWORDS,a2)		| default: nothing drawn
	tst.w	(CS_XY,a3)
	jeq		1f
	jbsr	draw_one_bob
1:
	lea		(DL_SIZEOF,a2),a2
	addq.w	#CS_SIZEOF,a3
	dbf		d7,0b
	rts

* < A2: draw list entry (back buffer)
* < A3: current sprite
* < A4: queue write pointer (updated)
* < D6: current setup key (updated)
* trashes D0-D5,A0,A1,A5,A6

draw_one_bob:
	* lookup render record: bob_rec_table[code][clut][mirror]
	moveq	#0,d0
	move.b	(CS_CODE,a3),d0
	lsl.w	#4,d0
	moveq	#0x0F,d1
	and.b	(CS_COLOR,a3),d1
	add.w	d1,d0
	lsl.w	#3,d0
	lea		bob_rec_table,a0
	add.w	d0,a0
	move.b	(CS_ATTR,a3),d4
	btst	#1,d4				| X mirror (flipx, but screen is rotated)
	jeq		0f
	move.l	(4,a0),d1			| pre-mirrored record
	jne		1f
	* mirror not declared for that bob: use normal one
0:
	move.l	(a0),d1
	jeq		99f					| unknown bob/clut combination: skip
1:
	move.l	d1,a5

	* position
	move.w	(CS_XY,a3),d0
	addq.w	#SPRITE_X_CORRECTION,d0
	move.w	(CS_XY+2,a3),d1
	add.w	#SPRITE_Y_CORRECTION,d1
	btst	#0,d4				| Y flip
	jne		2f
	add.w	(BR_YOFF,a5),d1
	jra		3f
2:
	add.w	(BR_YREV,a5),d1
3:
	cmp.w	#NB_LINES,d1
	jge		99f					| too low, not visible
	move.w	(BR_HEIGHT,a5),d3
	moveq	#0,d2				| clipped lines at top
	tst.w	d1
	jpl		4f
	move.w	d1,d2
	neg.w	d2
	sub.w	d2,d3
	jle		99f					| fully above the screen
	moveq	#0,d1
4:
	* D0: x, D1: clipped y top, D2: clipped lines, D3: clipped height

	* status bar overlap test (erase and draw of this bob)
	moveq	#0,d5
	move.w	d1,d4
	add.w	d3,d4				| bottom line
	cmp.w	#SBAR_TOP_LINE,d4
	jle		6f
	cmp.w	#SBAR_LEFT_END,d0
	jcc		5f
	bset	#SBAR_LEFT,d5
5:
	moveq	#0,d4
	move.b	(BR_NWORDS,a5),d4
	subq.w	#1,d4
	lsl.w	#4,d4
	add.w	d0,d4				| right edge
	cmp.w	#SBAR_RIGHT_START,d4
	jls		6f
	bset	#SBAR_RIGHT,d5
6:
	or.b	d5,sbar_flags		| tiles are redrawn over the bobs

	* destination offset
	lea		mul_ilv_table,a0
	add.w	d1,d1
	add.w	d1,d1
	move.l	(a0,d1.w),d1
	moveq	#0,d4
	move.w	d0,d4
	lsr.w	#3,d4
	and.w	#0xFFFE,d4
	add.l	d4,d1
	move.l	d1,(DL_DOFF,a2)

	moveq	#0,d4
	move.b	(BR_NWORDS,a5),d4	| D4: blit width in words
	move.b	d4,(DL_NWORDS,a2)

	* erase bltsize: 4 planes * height
	move.w	d3,d1
	lsl.w	#8,d1				| (4*h)<<6
	add.w	d4,d1
	move.w	d1,(DL_ESIZE,a2)
	* is it a short erase (D-only blit: 2 cycles per word)?
	cmp.b	#2,d4
	jne		7f
	cmp.w	#SPIN_DMA_CYCLES/16,d3
	jra		8f
7:
	cmp.w	#SPIN_DMA_CYCLES/24,d3
8:
	jcc		9f
	bset	#SBAR_SHORT_ERASE,d5
9:
	move.b	d5,(DL_SBAR,a2)

	* blitter control words for that shift
	and.w	#0xF,d0
	add.w	d0,d0
	add.w	d0,d0
	lea		cookie_cut_blit_table(pc),a0
	move.l	(a0,d0.w),d0		| D0: bltcon0/bltcon1

	move.l	bob_back_screen(pc),d5
	add.l	(DL_DOFF,a2),d5		| D5: destination (clipped top left)

	btst	#0,(CS_ATTR,a3)
	jne		draw_bob_planes_flipped
	btst	#BRF_ILV,(BR_FLAGS,a5)
	jeq		draw_bob_planes

	*** interleaved: one blit draws all 4 planes ***

	moveq	#SETUP_ILV,d1
	add.w	d4,d1
	cmp.w	d1,d6
	jeq		10f
	move.w	d1,d6
	jbsr	emit_setup
10:
	* source offset for clipped lines: lines * 4 planes * (nwords-1)*2 bytes
	moveq	#0,d1
	tst.w	d2
	jeq		11f
	move.w	d4,d1
	subq.w	#1,d1
	mulu	d2,d1
	lsl.l	#3,d1
11:
	* short? (ABCD, 4 cycles per word, 4*h lines)
	lea		r_cookie(pc),a0
	cmp.b	#2,d4
	jne		12f
	cmp.w	#SPIN_DMA_CYCLES/32,d3
	jra		13f
12:
	cmp.w	#SPIN_DMA_CYCLES/48,d3
13:
	jcc		14f
	lea		r_cookie_spin(pc),a0
14:
	move.l	a0,(a4)+
	move.l	d0,(a4)+				| bltcon0/1
	move.l	d5,(a4)+				| C
	move.l	(BR_ILVDATA,a5),a0
	add.l	d1,a0
	move.l	a0,(a4)+				| B
	move.l	(BR_ILVMASK,a5),a0
	add.l	d1,a0
	move.l	a0,(a4)+				| A
	move.l	d5,(a4)+				| D
	move.w	(DL_ESIZE,a2),(a4)+		| same size as erase
	PUBLISH
99:
	rts

	*** plane by plane, empty planes skipped (small aliens hack) ***
draw_bob_planes:
	moveq	#SETUP_PLANE,d1
	add.w	d4,d1
	cmp.w	d1,d6
	jeq		0f
	move.w	d1,d6
	jbsr	emit_setup
0:
	* source offset for clipped lines (original data: nwords*2 bytes per line)
	move.w	d2,d1
	mulu	d4,d1
	add.l	d1,d1
	jra		draw_planes

	*** y-flipped: plane by plane, destination goes upwards ***
draw_bob_planes_flipped:
	moveq	#SETUP_PLANE_FLIP,d1
	add.w	d4,d1
	cmp.w	d1,d6
	jeq		0f
	move.w	d1,d6
	jbsr	emit_setup
0:
	* start from the bottom line (clipped lines are the end of the source)
	lea		mul_ilv_table-4,a0
	move.w	d3,d1
	add.w	d1,d1
	add.w	d1,d1
	add.l	(a0,d1.w),d5		| + (h-1)*160
	moveq	#0,d1				| no source offset

* < D0: bltcon0/1
* < D1: source offset (clipping)
* < D3: height
* < D4: width in words
* < D5: destination for plane 0
* < A5: render record
draw_planes:
	lea		r_cookie(pc),a1
	move.w	d4,d2
	cmp.b	#2,d4
	jne		1f
	cmp.w	#SPIN_DMA_CYCLES/8,d3
	jra		2f
1:
	cmp.w	#SPIN_DMA_CYCLES/12,d3
2:
	jcc		3f
	lea		r_cookie_spin(pc),a1
3:
	move.w	d3,d4
	lsl.w	#6,d4
	add.w	d2,d4				| D4: bltsize
	move.l	(BR_MASK,a5),a6
	add.l	d1,a6				| A6: mask
	lea		(BR_PLANES,a5),a0
	moveq	#NB_BOBS_PLANES-1,d2
4:
	move.l	(a0)+,d3
	jeq		5f					| empty plane: skipped
	add.l	d1,d3
	move.l	a1,(a4)+
	move.l	d0,(a4)+			| bltcon0/1
	move.l	d5,(a4)+			| C
	move.l	d3,(a4)+			| B
	move.l	a6,(a4)+			| A
	move.l	d5,(a4)+			| D
	move.w	d4,(a4)+			| bltsize
	PUBLISH
5:
	add.l	#NB_BYTES_PER_ROW,d5	| next interleaved plane
	dbf		d2,4b
	rts

* < D6.W: setup key
* < A4: queue write pointer (updated)
emit_setup:
	movem.l	d0/a0,-(a7)
	move.l	#r_setup,(a4)+
	move.w	d6,d0
	lsl.w	#4,d0				| key*16
	lea		setup_table(pc),a0
	add.w	d0,a0
	move.l	(a0)+,(a4)+
	move.l	(a0)+,(a4)+
	move.l	(a0)+,(a4)+
	move.l	(a0)+,(a4)+
	movem.l	(a7)+,d0/a0
	rts

	.macro	SETUP_ENTRY	con,cmod,bmod,amod,dmod
	.long	\con
	.long	0xFFFF0000			| afwm, alwm (alwm=0 required by compact sources)
	.word	\cmod,\bmod,\amod,\dmod
	.endm

setup_table:
	SETUP_ENTRY	0,0,0,0,0		| 0: unused
	* clear (D only), 16 & 32 pixels, 4 interleaved planes
	SETUP_ENTRY	0x01000000,0,0,0,NB_BYTES_PER_ROW-4
	SETUP_ENTRY	0x01000000,0,0,0,NB_BYTES_PER_ROW-6
	* interleaved cookie cut, compact source (no shift word, alwm=0)
	SETUP_ENTRY	0,NB_BYTES_PER_ROW-4,-2,-2,NB_BYTES_PER_ROW-4
	SETUP_ENTRY	0,NB_BYTES_PER_ROW-6,-2,-2,NB_BYTES_PER_ROW-6
	* single plane cookie cut, original source (with shift word)
	SETUP_ENTRY	0,ILV_STRIDE-4,0,0,ILV_STRIDE-4
	SETUP_ENTRY	0,ILV_STRIDE-6,0,0,ILV_STRIDE-6
	* single plane cookie cut, y-flipped
	SETUP_ENTRY	0,-ILV_STRIDE-4,0,0,-ILV_STRIDE-4
	SETUP_ENTRY	0,-ILV_STRIDE-6,0,0,-ILV_STRIDE-6

	.macro		GEN_MINTERM_TABLE	name,value
\name\()_table:
	.set	shift,0
	.rept	16
	.long	(shift<<28)+(shift<<12)+\value
	.set	shift,shift+1
	.endr
	.endm

	GEN_MINTERM_TABLE	cookie_cut_blit,0x0FCA0000

*----------------------------------------------------------------------------
* blitter queue consumer
*
* called from the blitter interrupt, or by the producer (interrupts masked)
* when the blitter is idle
* < A5: custom
* trashes D0,A0,A1
*----------------------------------------------------------------------------

blitq_run:
	move.l	blitq_rd(pc),a0
blitq_next:
	cmp.l	blitq_wr(pc),a0
	jeq		blitq_empty
	move.l	(a0)+,a1
	jmp		(a1)
blitq_empty:
	move.l	a0,blitq_rd
	st.b	blit_idle
	tst.b	producer_done
	jne		chain_complete
	rts							| producer will restart us

r_setup:
	move.l	(a0)+,(bltcon0,a5)
	move.l	(a0)+,(bltafwm,a5)	| first/last word masks (never trust them)
	move.l	(a0)+,(bltcmod,a5)	| C & B modulos
	move.l	(a0)+,(bltamod,a5)	| A & D modulos
	jra		blitq_next

r_clear:
	move.l	(a0)+,(bltdpt,a5)
	move.w	(a0)+,(bltsize,a5)
	move.l	a0,blitq_rd
	rts

r_cookie:
	move.l	(a0)+,(bltcon0,a5)
	lea		(bltcpt,a5),a1
	move.l	(a0)+,(a1)+			| C
	move.l	(a0)+,(a1)+			| B
	move.l	(a0)+,(a1)+			| A
	move.l	(a0)+,(a1)+			| D
	move.w	(a0)+,(a1)			| bltsize: go!
	move.l	a0,blitq_rd
	rts

r_clear_spin:
	move.l	(a0)+,(bltdpt,a5)
	move.w	#IRQ_BLIT,(intreq,a5)	| clear "done" flag, we'll poll it
	move.w	(a0)+,(bltsize,a5)
	jra		blitq_spin

r_cookie_spin:
	move.l	(a0)+,(bltcon0,a5)
	lea		(bltcpt,a5),a1
	move.l	(a0)+,(a1)+			| C
	move.l	(a0)+,(a1)+			| B
	move.l	(a0)+,(a1)+			| A
	move.l	(a0)+,(a1)+			| D
	move.w	#IRQ_BLIT,(intreq,a5)	| clear "done" flag, we'll poll it
	move.w	(a0)+,(a1)			| bltsize: go!
* short blit: cheaper to wait here than to take another interrupt
* we poll the BLIT interrupt request rather than BBUSY: on OCS/68000,
* BBUSY can still read 0 a few cycles after the BLTSIZE write (blitter
* start delayed by bitplane DMA), and we'd program the next blit over
* a running one
blitq_spin:
0:
	btst	#6,(intreqr+1,a5)
	jeq		0b
	move.w	#IRQ_BLIT,(intreq,a5)	| this one is handled
	jra		blitq_next


* producer side: start the chain if the blitter is idle
blitq_kick:
	move.w	sr,-(a7)
	or.w	#0x0700,sr
	tst.b	blit_idle
	jeq		0f
	movem.l	d0/a0-a1/a5,-(a7)
	lea		_custom,a5
	clr.b	blit_idle
	jbsr	blitq_run
	movem.l	(a7)+,d0/a0-a1/a5
0:
	move.w	(a7)+,sr
	rts

* all blits of the frame are done (level 3, or masked level 1)
* finish the back buffer with the CPU, then declare it ready to be shown
chain_complete:
	movem.l	d0-d7/a0-a6,-(a7)
	lea		ram_start_8000,a6
	jbsr	flush_deferred_tiles
	jbsr	refresh_status_bar
	move.b	#FS_READY,frame_state
	movem.l	(a7)+,d0-d7/a0-a6
	rts

*----------------------------------------------------------------------------
* status bar refresh (back buffer, after all blits)
* tiles with colors in planes 2/3 (ships, flags) were damaged by
* bobs erase/draw: OR them again over the bobs
*----------------------------------------------------------------------------

refresh_status_bar:
	btst	#SBAR_LEFT,sbar_flags
	jeq		0f
	move.w	#0x0014,d7			| ships
	jbsr	redraw_2_rows
0:
	btst	#SBAR_RIGHT,sbar_flags
	jeq		1f
	move.w	#0x0002,d7			| level flags
	jbsr	redraw_2_rows
1:
	rts

* < D7: video offset of the first tile of row 34
redraw_2_rows:
	moveq	#12-1,d4
0:
	move.w	d7,-(a7)
	jbsr	tile_or_back
	add.w	#0x20,d7			| same column, row 35
	jbsr	tile_or_back
	move.w	(a7)+,d7
	addq.w	#1,d7
	dbf		d4,0b
	rts

*----------------------------------------------------------------------------
* buffers
*----------------------------------------------------------------------------

* swap front/back (level 3, bottom of screen)
switch_screen_buffers:
	move.l	bob_back_screen(pc),d0
	move.l	bob_front_screen(pc),bob_back_screen
	move.l	d0,bob_front_screen
	move.l	bob_back_list(pc),d0
	move.l	bob_front_list(pc),bob_back_list
	move.l	d0,bob_front_list
	* fallthrough

* set_bitplanes
* what: sets bitplanes in copperlist
* BPL1-4: interleaved bob planes of the displayed buffer
* BPL5: char plane (shared)
set_bitplanes:
	lea		panel_bitplanes+2,a0
	move.l	bob_front_screen(pc),d0
	moveq	#NB_BOBS_PLANES-1,d1
0:
	swap	d0
	move.w	d0,(a0)
	swap	d0
	move.w	d0,(4,a0)
	addq.w	#8,a0
	add.l	#NB_BYTES_PER_ROW,d0
	dbf		d1,0b
	move.l	char_plane_ptr(pc),d0
	swap	d0
	move.w	d0,(a0)
	swap	d0
	move.w	d0,(4,a0)
	rts

*----------------------------------------------------------------------------
* startup: build render records from graphics.68k bob blocks, and convert
* 3 & 4 plane bobs to interleaved format (graphics.68k is left untouched)
*----------------------------------------------------------------------------

build_bob_records:
	movem.l	d0-d7/a0-a6,-(a7)
	move.l	#bob_records,rec_alloc_ptr
	move.l	#ilv_pool,ilv_alloc_ptr
	clr.w	mask_cache_count
	lea		bob_table,a0
	lea		bob_rec_table,a1
	lea		double_size_flag_table,a4
	moveq	#0,d7				| bob code
0:
	move.l	(a0)+,d0
	jeq		5f					| not declared
	jmi		5f					| hardware sprite
	move.l	d0,a2				| per-clut block table
	moveq	#4,d6				| source bytes per line (16 pixels + shift word)
	tst.b	(a4,d7.w)
	jeq		1f
	moveq	#6,d6				| 32 pixels + shift word
1:
	moveq	#NB_CLUTS-1,d5
2:
	move.l	(a2)+,d0
	jeq		4f
	move.l	d0,a3
	jbsr	make_bob_record
	move.l	d0,(a1)
	lea		(GB_SIZEOF,a3),a3	| pre-mirrored block
	cmp.l	#-1,(GB_PLANES,a3)
	jeq		4f					| no mirror
	jbsr	make_bob_record
	move.l	d0,(4,a1)
4:
	addq.w	#8,a1
	dbf		d5,2b
	jra		6f
5:
	lea		(NB_CLUTS*8,a1),a1
6:
	addq.w	#1,d7
	cmp.w	#NB_BOB_CODES,d7
	jne		0b
	movem.l	(a7)+,d0-d7/a0-a6
	rts

* < A3: graphics.68k block
* < D6: source bytes per line (4 or 6)
* > D0: render record, 0 if not drawable/no room
make_bob_record:
	movem.l	d1-d5/a0-a2/a4-a5,-(a7)
	moveq	#0,d0
	tst.l	(GB_MASK,a3)
	jeq		99f					| mask is zero: blank tile => never drawn
	move.l	rec_alloc_ptr(pc),a5
	cmp.l	#bob_records_end,a5
	jcc		99f					| no room (shouldn't happen)
	lea		(BR_SIZEOF,a5),a0
	move.l	a0,rec_alloc_ptr

	clr.b	(BR_FLAGS,a5)
	move.w	d6,d0
	lsr.w	#1,d0
	move.b	d0,(BR_NWORDS,a5)
	move.w	(a3),(BR_HEIGHT,a5)
	move.w	(2,a3),(BR_YOFF,a5)
	move.w	(4,a3),(BR_YREV,a5)
	clr.l	(BR_ILVDATA,a5)
	clr.l	(BR_ILVMASK,a5)
	lea		(GB_PLANES,a3),a0
	lea		(BR_PLANES,a5),a1
	moveq	#0,d2				| non-empty planes count
	moveq	#NB_BOBS_PLANES-1,d1
1:
	move.l	(a0)+,d0
	move.l	d0,(a1)+
	jeq		2f
	addq.w	#1,d2
2:
	dbf		d1,1b
	move.l	(a0),(BR_MASK,a5)

	cmp.w	#ILV_MIN_PLANES,d2
	jcs		90f					| few planes: blitted plane by plane (and empty ones skipped)

	move.w	(a3),d3				| D3: height
	move.w	d6,d4
	subq.w	#2,d4				| compact source bytes per line
	mulu	d3,d4
	lsl.w	#2,d4				| D4: item size = h * 4 planes * srcw
	move.w	d4,d0
	jbsr	ilv_alloc
	move.l	a4,d0
	jeq		90f					| no room left: plane by plane

	* interleaved data
	move.l	a4,(BR_ILVDATA,a5)
	moveq	#0,d1				| offset of the line in source planes
	move.w	d3,d5
	subq.w	#1,d5
3:
	lea		(BR_PLANES,a5),a1
	moveq	#NB_BOBS_PLANES-1,d2
4:
	move.l	(a1)+,d0
	jeq		6f
	move.l	d0,a0
	add.l	d1,a0
	move.w	(a0)+,(a4)+
	cmp.w	#6,d6
	jne		7f
	move.w	(a0)+,(a4)+
	jra		7f
6:
	* empty plane: zeroes (cookie cut will write color 0 bits there)
	clr.w	(a4)+
	cmp.w	#6,d6
	jne		7f
	clr.w	(a4)+
7:
	dbf		d2,4b
	add.w	d6,d1
	dbf		d5,3b

	* interleaved mask (shared between blocks using the same mask)
	move.l	(BR_MASK,a5),d0
	lea		mask_cache,a0
	move.w	mask_cache_count(pc),d2
	jra		11f
10:
	cmp.l	(a0)+,d0
	jeq		12f
	addq.w	#4,a0
11:
	dbf		d2,10b
	* not found: allocate & build it
	move.l	d0,a1				| mask source
	move.w	d4,d0
	jbsr	ilv_alloc
	move.l	a4,d0
	jne		13f
	clr.l	(BR_ILVDATA,a5)		| no room for the mask: plane by plane
	jra		90f					| (data space is lost, harmless)
13:
	cmp.w	#MASK_CACHE_SIZE,mask_cache_count
	jcc		14f
	move.l	a1,(a0)+
	move.l	a4,(a0)
	addq.w	#1,mask_cache_count
14:
	move.l	a4,(BR_ILVMASK,a5)
	move.l	a1,a0
	move.w	d3,d5
	subq.w	#1,d5
15:
	moveq	#NB_BOBS_PLANES-1,d2
16:
	move.w	(a0),(a4)+
	cmp.w	#6,d6
	jne		17f
	move.w	(2,a0),(a4)+
17:
	dbf		d2,16b
	add.w	d6,a0
	dbf		d5,15b
	jra		18f
12:
	move.l	(a0),(BR_ILVMASK,a5)
18:
	bset	#BRF_ILV,(BR_FLAGS,a5)
90:
	move.l	a5,d0
99:
	movem.l	(a7)+,d1-d5/a0-a2/a4-a5
	rts

* chip memory for converted bobs: first fit in the unused part of
* the char plane lines, then the regular pool
* < D0.W: size in bytes (even)
* > A4: chip address, 0 if no room
ilv_alloc:
	movem.l	d1-d2/a0,-(a7)
	cmp.w	#CHAR_GAP_SIZE,d0
	jhi		2f					| too big for a gap (32x32 explosions)
	lea		char_gap_fill,a0
	moveq	#0,d1				| char plane line
0:
	moveq	#0,d2
	move.b	(a0,d1.w),d2
	add.w	d0,d2
	cmp.w	#CHAR_GAP_SIZE,d2
	jls		1f
	addq.w	#1,d1
	cmp.w	#CHAR_PLANE_LINES,d1
	jne		0b
	jra		2f					| all gaps full
1:
	moveq	#0,d2
	move.b	(a0,d1.w),d2		| offset in gap
	add.b	d0,(a0,d1.w)
	lea		mul_ilv_table,a0
	add.w	d1,d1
	add.w	d1,d1
	move.l	(a0,d1.w),a4
	add.l	char_plane_ptr(pc),a4
	add.w	#CHAR_GAP_OFFSET,d2
	add.w	d2,a4
	jra		9f
2:
	move.l	ilv_alloc_ptr(pc),a4
	moveq	#0,d1
	move.w	d0,d1
	add.l	a4,d1
	cmp.l	#ilv_pool_end,d1
	jhi		3f
	move.l	d1,ilv_alloc_ptr
	jra		9f
3:
	sub.l	a4,a4
9:
	movem.l	(a7)+,d1-d2/a0
	rts
	
* < D0: sprite X
* < D1: sprite Y
* < D2: sprite code & flags
* < D3: sprite color (clut index, plus encoded flip information on last 2 bits)
* > D6: allocated sprite index
* D4 and D5 are destroyed
alloc_sprite:
	* first pass: find a free sprite next to a sprite with
	* same clut
	lea		host_sprites(pc),a2
	moveq	#0,d6
0:
	move.b	(SPRITE_CLUT,a2),d4
	move.b	d3,d5
	and.b	#0x0F,d4
	and.b	#0x0F,d5
	cmp.b	d4,d5
	bne.b	10f
	* allocated (else would be -1/invalid) + same clut
	* check even/odd index
	btst	#0,d6
	beq.b	1f
	* odd: check if previous entry is free
	tst.b	(SPRITE_X-SPRITE_SIZEOF,a2)
	beq.b	8f
	tst.b	(SPRITE_Y-SPRITE_SIZEOF,a2)
	bne.b	10f
8:
	* previous entry is free, same clut: we can use that
	* entry, no color conflict
	lea		(-SPRITE_SIZEOF,a2),a2
9:
	
	move.b	d0,(a2)+		| X
	move.b	d1,(a2)+		| Y
	move.b	d2,(a2)+		| code
	move.b	d3,(a2)+		| clut (plus flip information)
	rts						| done
1:
	* even: check if next entry is free
	tst.b	(SPRITE_X+SPRITE_SIZEOF,a2)
	beq.b	2f
	tst.b	(SPRITE_Y+SPRITE_SIZEOF,a2)
	bne.b	10f
2:
	* next entry is free, same clut: we can use that
	* entry, no color conflict
	lea		(SPRITE_SIZEOF,a2),a2
	bra.b	9b
10:
	* next entry
	addq.w	#SPRITE_SIZEOF,a2
	addq	#1,d6
	cmp.w	#NB_HOST_SPRITES,d6
	bne.b	0b
	* second pass if first pass failed (could not match
	* a pair with one occupied slot with compatible clut,
	* which happens when there are very few sprites
	* displayed): we have to find 2 consecutive free slots

	lea		host_sprites(pc),a2
	moveq	#0,d6
11:
	* we consider that a sprite is not allocated
	* if one of the coordinates is zero (real game
	* doesn't care and sets X to 255, and Y to 0 at times
	tst.b	(SPRITE_Y,a2)
	beq.b	12f
	tst.b	(SPRITE_X,a2)
	bne.b	20f
12:
	* not allocated: test odd sprite
	tst.b	(SPRITE_Y+SPRITE_SIZEOF,a2)
	jeq	9b
	tst.b	(SPRITE_X+SPRITE_SIZEOF,a2)
	jeq	9b		| ok, both slots are free, allocate the first one
20:
	* next sprite pair
	lea		(2*SPRITE_SIZEOF,a2),a2
	addq	#2,d6
	cmp.w	#NB_HOST_SPRITES,d6
	bne.b	11b
	
	* third pass: last chance/emergency: there ARE free slots
	* but maybe too many different cluts so we can't find a suitable slot.
	* In that case, pick the first free slot
	*
	lea		host_sprites(pc),a2
	moveq	#0,d6
21:
	tst.b	(SPRITE_X,a2)
	beq.b	9b		| ok, a slot is free, allocate it
	tst.b	(SPRITE_Y,a2)
	beq.b	9b		| ok, a slot is free, allocate it
30:
	* next sprite
	lea		(SPRITE_SIZEOF,a2),a2
	addq	#1,d6
	cmp.w	#NB_HOST_SPRITES,d6
	bne.b	21b
	* just cannot happen
	* if we reach that point there's a big problem, break if dev mode
	* hopefully if we save buffer in A1 we can reproduce the issue at will!
	.ifndef	RELEASE
	lea		o_sfr_sprite_code_8B80(a6),a1
	lea			sprite_allocation_error,a0
	jbsr	osd_break
	.endif
	* in release mode, just discard this sprite, maybe we'll get away with it!
	rts
	


osd_sound_start:
	movem.l	d0-d2/a0-a1/a6,-(a7)
	and.w	#0xFF,d0
	

	move.w	d0,d2
	lsl.w	#3,d0
	lea		sound_table,a0
	lea		playing_sounds(pc),a1

	move.w	(a0,d0.w),d1	| sound type
	beq.b	0f		| no sound
	lea		_custom,a6
	
	cmp.w	#1,d1
	bne.b	4f		| music module

	* override music block for some sounds
	cmp.w	#EXTRA_LIFE_SND,d2
	beq.b	10f
	cmp.w	#CREDIT_SND,d2
	beq.b	10f

	
	* don't play if already playing
	* (music_tick value is not important for looped tunes
	* as long as it's not zero)
	tst.w	music_tick
	bne.b	1f
10:
	move.w	(2,a0,d0.w),d1
	move.l	(4,a0,d0.w),a0
	tst.w	d1
	beq.b	3f
	* looped sound

	tst.b	(a1,d2.w)
	bne.b	1f				| loop already playing: skipped

	st		(a1,d2.w)
	jsr		_mt_loopfx
	bra.b	1f
3:
	jsr		_mt_playfx
1:
	movem.l	(a7)+,d0-d2/a0-a1/a6
	rts
0:

	bra.b	1b
	* music
4:
	* play the proper module pattern
	* load up the countdown if loop
	move.w	(2,a0,d0.w),d1	| pattern number in .mod file
	* since it's not zero, next vbl tick will play the music
	
	cmp.b	music_track_start_number(pc),d1
	beq.b	1b		| same track, skip

    movem.l d0-a6,-(a7)
	bsr		osd_sound_stop
    lea _custom,a6
 	movem.l	d0/a0,-(a7)
	* note that this sound is playing!
	lea		playing_sounds(pc),a0
	st.b	(a0,d2.w)
    lea	galaga_tunes,a0
	move.b	d1,music_track_start_number
	move.w	d1,d0
    sub.l   a1,a1		| samples are in the module
    jsr _mt_init
	movem.l	(a7)+,d0/a0

    * set master volume a little less loud if needed
	move.b	(6,a0,d0.w),music_volume
	move.b	(7,a0,d0.w),music_loops
	move.w	(2,a0,d0.w),music_pattern	| pattern number in .mod file
	move.w	(4,a0,d0.w),d2

	move.w	d2,music_duration
	move.w	d2,music_tick

    moveq	#0,d0
	move.b	music_volume(pc),d0
    jsr	_mt_mastervol
	st.b	music_playing
    jsr _mt_start
    movem.l (a7)+,d0-a6
	
6:
	jra	1b

7:
	jra	1b

	
osd_loop_stop:
	movem.l	d0/a0/a6,-(a7)
	lea		_custom,a6
	move.w	#LOOP_CHANNEL,d0		| channel used by sound loops
	jbsr	_mt_stopfx
	lea		playing_sounds(pc),a0
	clr.b	(SWARM_SND,a0)
	movem.l	(a7)+,d0/a0/a6
	rts

osd_sound_stop:
	movem.l	d0/a0/a6,-(a7)
	lea		_custom,a6
	move.b	#-1,music_track_start_number
    clr.w   music_tick   | not playing anymore
	clr.b	music_playing
    jsr		_mt_end
	lea		playing_sounds(pc),a0
	move.w	#SND_COUNT/4-1,d0
0:
	clr.l	(a0)+
	dbf		d0,0b
	
	movem.l	(a7)+,d0/a0/a6
	rts
	


* so memory is quadword-aligned (not trusting .align directives)
align_for_fmode:
	add.w	#0x10,a0
	move.l	a0,d0
	and.b	#0xF8,d0
	move.l	d0,a0
	rts
	
store_system:
	tst.l	_resload
	beq.b	0f
	rts
0:
	* system copper
	
	move.l	4.W,a6
	move.w	AttnFlags(a6),d0
	btst	#AFB_68010,d0
	beq.b	1f
	lea	get_vbr,a5

	jsr		_LVOSupervisor(a6)
	move.l	d0,system_vbr
	
	
1:
	pea		2f(pc)	
2:
	move.l	(a7)+,d0
	cmp.l	#0x200000,d0
	bcs.b	3f				| will crawl if no fastmem
	move.w	AttnFlags(a6),d0
	btst	#AFB_68020,d0
	bne.b	1f
3:
	* no whdload, no 68020: assume slow
	* if running on PiStorm, well, too bad use whdload
	st.b	static_stars
	move.b	#2,fps_divider		| 1 frameskip, will still be slow
1:
	lea	_custom,a6
	move.w	intenar(a6),old_intena
	move.w	dmaconr(a6),old_dmacon
	lea		old_sysvectors,a0
	move.l	system_vbr(pc),a1
	move.l	(0x64,a1),(a0)+
	move.l	(0x68,a1),(a0)+
	move.l	(0x6c,a1),(a0)+
	move.l	(0x70,a1),(a0)+
	move.l	(0x74,a1),(a0)+
	move.l	(0x78,a1),(a0)+
	move.l	(0x7C,a1),(a0)+
	rts

restore_system:
	lea	_custom,a6
	jsr		_mt_remove_cia

	move.w	#0x4000,intena(a6)	| ints off
	* wait for the blit chain to drain
	tst.b	dmaconr(a6)
0:
	btst	#6,dmaconr(a6)
	jne		0b
	lea		old_sysvectors,a0
	move.l	system_vbr(pc),a1
	move.l	(a0)+,(0x64,a1)
	move.l	(a0)+,(0x68,a1)
	move.l	(a0)+,(0x6c,a1)
	move.l	(a0)+,(0x70,a1)
	move.l	(a0)+,(0x74,a1)
	move.l	(a0)+,(0x78,a1)
	move.l	(a0)+,(0x7C,a1)


	bclr	#6,0xbfee01


	lea	_custom,a6
	move.w	old_intena,d0			| get old val
	and.w	#0x3fff,d0
	eor.w	#0x3fff,d0
	move.w	d0,intena(a6)		| clr bits
	eor.w	#0x3fff,d0
	or.w	#0xc000,d0		
	move.w	d0,intena(a6)		| set bits and main

	move.w	old_dmacon,d0			| get old val
	and.w	#0x3fff,d0
	eor.w	#0x3fff,d0

***		and.w	#0xfff0,d0		| preserve sound dma for now

	move.w	d0,dmacon(a6)		| clr bits



	eor.w	#0x3fff,d0
	or.w	#0xc000,d0		
	move.w	d0,dmacon(a6)		| set bits and main

	move.l	old_syscoplist,cop1lc(a6)
	move.l	_gfxbase,a6
	move.l	old_actiview,a1
	jsr	_LVOLoadView(a6)


	moveq	#0,d0
	rts

quit_to_os:
	tst.l	_resload
	bne.b	0f
	bsr		restore_system
	* set SR to 0 from here, so we return to OS with SR=0
	* (else it kills the system pretty quickly)
	* it works as quit_to_os is called from an interrupt
	move.w	#0,SR
	move.l	old_stack(pc),a7
	bsr		save_highscores
	moveq	#0,d0
	rts
0:
	pea	  TDREASON_OK
	move.l	_resload(pc),-(a7)
	addq.l	#resload_Abort,(a7)
	rts

platform_init:
	bsr		store_system

	lea		_custom,a5
	move.w	#0x7FFF,dmacon(a5)
	move.w	#0x7FFF,intena(a5)
	move.w	#0x7FFF,intreq(a5)
	* blitter masks are (re)set by each setup entry of the blit queue
	* (OS blitter usage during WHDLoad/DOS file I/O can clobber them)

	* render records & interleaved bobs
	jbsr	build_bob_records
	move.b	#FS_FREE,frame_state
	st.b	blit_idle

	* restrict borders: we don't see bobs on the borders!
	*         VVHH
    move.w #(HFIRSTROW<<8) + 0x99,diwstrt(a5)
    move.w #0x3881-8,diwstop(a5)
    move.w #0x0038,ddfstrt(a5)
    move.w #0x00D0,ddfstop(a5)
	* using one extra bitplane for monoplanar chars (letters)
    move.w #0x200+(NB_PLAYFIELD_PLANES<<12)+BORDERBLANK,bplcon0(a5)
    move.w #BASE_BPLCON2_VALUE,bplcon2(a5)
	* AGA-compatible ECS default values
    move.w #0x0C00+BORDERBLANK<<5,bplcon3(a5)     | no AGA specificities, default ECS
    move.w #0x0011,bplcon4(a5)     | ECS default for sprite colors
    move.w #0,fmode(a5)
    move.w #0,bplcon1(a5)
	* interleaved bob planes, char plane uses the same stride
	move.w	#BPL_MODULO,d0
    move.w d0,bpl1mod(a5)
    move.w d0,bpl2mod(a5)

	* read twice to make sure!
	move.w	0xdff07c,d0
	cmp.b	#0xF8,d0		|  AGA (Lisa) is $f8.
	bne.b	0f
	move.w	0xdff07c,d0
	cmp.b	#0xF8,d0		|  AGA (Lisa) is $f8.
	bne.b	0f

    move.w #3,fmode(a5)
	move.w	#BPL_MODULO-8,d0
    move.w d0,bpl1mod(a5)
    move.w d0,bpl2mod(a5)

0:

	* set other sprites to blank, even the one used for stars
	move.l		#blank_sprite,d0

	moveq	#7,d1
	lea		sprites,a1
0:
    move.w	d0,(6,a1)
	swap	d0
    move.w	d0,(2,a1)
	swap	d0
	addq.w	#8,a1
	dbf		d1,0b

	bsr		set_bitplanes


	* set copperlist
	move.l	#main_copperlist,cop1lc(a5)

	* wait 300 lines
	move.w	#100,d0
	bsr	beamdelay
	move.w	#100,d0
	bsr	beamdelay
	move.w	#100,d0
	bsr	beamdelay

    * init sprite, bitplane, blitter, copper dma

    move.w #0x83E0,dmacon(a5)

	* install level 1 (game job), keyboard, level 3 (blitter/copper/vblank)
	move.l	system_vbr(pc),a1
	pea		level1_interrupt(pc)
	move.l	(a7)+,(0x64,a1)
	pea		level2_interrupt(pc)
	move.l	(a7)+,(0x68,a1)
	pea		level3_interrupt(pc)
	move.l	(a7)+,(0x6C,a1)
	pea		_nmi(pc)
	move.l	(a7)+,(0x7C,a1)

	* soundfx lib
	lea		_custom,a6
	lea		blank_sound,a0
	move.l	a0,(0xA0,a6)
	move.l	a0,(0xB0,a6)
	move.l	a0,(0xC0,a6)
	move.l	a0,(0xD0,a6)
	move.l	system_vbr(pc),a0
	moveq	#1,d0	| PAL
	jsr		_mt_install_cia

	.ifne	OPT_ENABLE_PROFILING
	* init profiling if enabled
	lea		0x180000,a0
	move.l	#0x20000,d0
	lea		0x100,a1
	bsr		init_fixed_address
	bsr		install_profiler_vbl_hook
	.endif

	* keyboard, frame timing & blitter interrupts are always on.
	* The level 1 game job (SOFTINT) is enabled by the game
	* through osd_interrupt_control (Z80 ei/di)
	lea		_custom,a5
	move.w	#IRQ_SET+IRQ_MASTER+IRQ_PORTS+IRQ_COPER+IRQ_VERTB+IRQ_BLIT,intena(a5)

    rts
load_palette_in_copperlist:
	movem.l	d0-d1/a0-a1,-(a7)
	lea		palette(pc),a0
	move.w	#TOTAL_NB_COLORS*2,d0
	lea		colors,a1
	bsr		load_palette
	movem.l	(a7)+,d0-d1/a0-a1

	
	rts

	

playing_sounds:
	.skip	SND_COUNT

* < A0: palette
* < A1: copperlist
* < D0: number of colors to load	
load_palette:
	subq.w	#1,d0
	beq.b	2f
1:
	addq.w	#2,a1
	move.w	(a0)+,(a1)+
	dbf		d0,1b
2:
	rts
	

osd_is_vblank_interrupt_enabled:
	move.w	_custom+intenar,d0
	btst	#2,d0			| check game job interrupt
	rts

* < d0: 0 disable interrupts, 1 enable interrupts
* (Z80 di/ei): only the level 1 game job is masked/unmasked.
* A tick requested while disabled stays pending (intreq) and runs at "ei"
* like the Z80 IRQ line would. Blitter chain, music & keyboard keep running.
osd_interrupt_control:
	tst.b	interrupt_mode
	bne.b	0f				| no interrupt change from within an IRQ
	tst.b	d0
	beq.b	1f
osd_enable_interrupts:
	move.w	#IRQ_SET+IRQ_MASTER+IRQ_SOFT,_custom+intena
0:
	rts

1:
	move.w	#IRQ_SOFT,_custom+intena
	rts

	


* < D4: sprite properties
*     Y code+attrs clut X
* > D0,D1: X,Y.B
* > D5: clut index
* > D6: sprite index + attributes
* 
decode_sprite_data:
	move.b	d4,d1	| sprite X (aka Y on amiga)
	lsr.l	#8,d4
	move.b	d4,d5	| clut index
	lsr.l	#8,d4
	move.b	d4,d6	| sprite index
	lsr.l	#8,d4	
	move.b	d4,d0	| sprite Y (aka X on amiga)
	rts

*============================================================================
* TILES
*
* char plane (plane 4) is shared by both buffers and never touched by the
* blitter: written immediately.
* some tiles (status bar ships/flags, logo, colored letters) also use
* bob planes: they're written in the front buffer, and in the back
* buffer unless the blit chain is drawing into it, in which case
* the write is deferred until the chain completes.
*============================================================================

* d7=screen address (preserved), d0=tile (preserved)
* should preserve all registers

osd_w_videoram:
    .ifeq OPT_DISABLE_BG_LAYER
	movem.l	d0-d7/a0-a6,-(a7)

	sub.w	#SCREEN_ADDRESS,d7
	bcs.b	0f
	cmp.w	#0x400,d7
	bcs.b	1f
0:
	.ifndef		RELEASE
	* should not happen
	add.w	#SCREEN_ADDRESS,d7
	lea		write_videoram_out_of_range_error(pc),a0
	jbsr	osd_break
	nop
	.endif
	jra		2f

1:
	lea		ram_start_8000,a1
	add.w	d7,a1

	cmp.b	(a1),d0
	jeq		2f		| already the proper value
	move.b	d0,(a1)	| update logical grid
	jbsr	tile_write
2:
	movem.l	(a7)+,d0-d7/a0-a6
    .endif | OPT_DISABLE_BG_LAYER
	rts

* < D0: tile code
* > A0: plane list (char plane, then bob planes 3 to 0, -1 terminated)
*       or 0 for blank (clear everything)
* > D0: 0 if tile can be drawn, -1 if not (unknown tile: left as is)
tile_get_list:
	and.w	#0xFF,d0
	sub.l	a0,a0
	cmp.w	#0x24,d0		| well-known empty character
	jeq		1f
	tst.b	d0
	jmi		2f
	lea		character_table,a0
	add.w	d0,d0
	add.w	d0,d0
	move.l	(a0,d0.w),a0
	move.l	a0,d0
	jeq		2f
1:
	moveq	#0,d0
	rts
2:
	moveq	#-1,d0
	rts

* < D7: offset in video RAM (0-0x3FF)
* > D1: byte offset in a 160-stride buffer, -1 if not visible
* preserves all other registers
tile_locate:
	movem.l	d3/d7/a0,-(a7)
	jbsr	compute_tile_xy
	moveq	#-1,d1
	cmp.w	#MAX_ROW_X,d7
	jcc		0f				| above 30: ignore
	cmp.w	#2,d7
	jcs		0f				| below 2: ignore
	lsl.w	#3,d3			| row => line
	cmp.w	#264,d3
	jcs		1f
	subq.w	#3,d3			| last rows are too low!
1:
	add.w	d3,d3
	add.w	d3,d3
	lea		mul_ilv_table,a0
	move.l	(a0,d3.w),d1
	add.w	d7,d1			| + column (no carry: offset < 65536)
0:
	movem.l	(a7)+,d3/d7/a0
	rts

* d7: screen offset (0-0x3FF)
* d0: tile code
* trashes all registers but d7

tile_write:
	and.w	#0xFF,d0	| mask up to 255

	cmp.w	#0x1FE,d7	| namco logo position
	jne		0f
	cmp.b	#0x32,d0
	jne		10f
	* namco logo drawn: set bottom to red
	jbsr	set_namco_rows_red
	jra		0f
10:
	cmp.b	#0x24,d0
	jne		0f
	* space drawn: reset dynamic rows
	jbsr	reset_namco_rows
0:
	jbsr	tile_locate
	tst.l	d1
	jmi		99f
	jbsr	tile_get_list
	tst.l	d0
	jmi		99f

	*** char plane ***
	move.l	char_plane_ptr(pc),a1
	add.l	d1,a1
	move.l	a0,d0
	jeq		2f
	move.l	(a0),d0
	jle		2f			| 0/-1: clear
	move.l	d0,a2
	.set	offset,0
	.rept	8
	move.b	(a2)+,(offset,a1)
	.set	offset,offset+ILV_STRIDE
	.endr
	jra		3f
2:
	.set	offset,0
	.rept	8
	clr.b	(offset,a1)
	.set	offset,offset+ILV_STRIDE
	.endr
3:
	*** bob planes ***
	* does that tile use bob planes?
	moveq	#0,d3
	move.l	a0,d0
	jeq		5f
	lea		(4,a0),a1
	moveq	#NB_BOBS_PLANES-1,d2
4:
	move.l	(a1)+,d0
	jmi		5f
	jeq		6f
	moveq	#1,d3
	jra		5f
6:
	dbf		d2,4b
5:
	* also needed if the previous tile had bob planes (to clear them)
	lea		cell_bob_flags,a1
	move.b	(a1,d7.w),d0
	or.b	d3,d0
	jeq		99f			| neither: nothing to do in bob planes
	move.b	d3,(a1,d7.w)

	DISABLE_INTS	| buffers can't be swapped/drawn while we're writing
	move.l	bob_front_screen(pc),a1
	add.l	d1,a1
	jbsr	tile_bob_planes_write
	cmp.b	#FS_BUSY,frame_state
	jeq		7f
	move.l	bob_back_screen(pc),a1
	add.l	d1,a1
	jbsr	tile_bob_planes_write
	ENABLE_INTS
99:
	rts

7:
	* blit chain running in back buffer: defer
	move.w	deferred_count(pc),d0
	cmp.w	#MAX_DEFERRED_TILES,d0
	jcc		8f
	lea		deferred_tiles,a1
	add.w	d0,d0
	move.w	d7,(a1,d0.w)
	addq.w	#1,deferred_count
	ENABLE_INTS
	rts
8:
	* deferred list full: wait for the chain to complete (blitter interrupt
	* is unmasked again while we wait), then write directly
	ENABLE_INTS
9:
	cmp.b	#FS_BUSY,frame_state
	jeq		9b
	DISABLE_INTS
	move.l	bob_back_screen(pc),a1
	add.l	d1,a1
	jbsr	tile_bob_planes_write
	ENABLE_INTS
	rts

* write (copy or clear) the 4 bob planes of a tile
* < A0: plane list (0: clear)
* < A1: buffer + tile offset
tile_bob_planes_write:
	movem.l	d0/d2/a0/a2-a3,-(a7)
	lea		(3*NB_BYTES_PER_ROW,a1),a3	| plane 3 first (list order)
	moveq	#NB_BOBS_PLANES-1,d2
	move.l	a0,d0
	jeq		5f
	addq.w	#4,a0				| skip char plane
0:
	move.l	(a0)+,d0
	jmi		5f					| end of list: clear remaining planes
	jeq		3f
	move.l	d0,a2
	.set	offset,0
	.rept	8
	move.b	(a2)+,(offset,a3)
	.set	offset,offset+ILV_STRIDE
	.endr
	jra		4f
3:
	.set	offset,0
	.rept	8
	clr.b	(offset,a3)
	.set	offset,offset+ILV_STRIDE
	.endr
4:
	lea		(-NB_BYTES_PER_ROW,a3),a3
	dbf		d2,0b
	jra		9f
5:
	.set	offset,0
	.rept	8
	clr.b	(offset,a3)
	.set	offset,offset+ILV_STRIDE
	.endr
	lea		(-NB_BYTES_PER_ROW,a3),a3
	dbf		d2,5b
9:
	movem.l	(a7)+,d0/d2/a0/a2-a3
	rts

* OR the bob planes of a tile over the back buffer (status bar refresh)
* < D7: offset in video RAM
* preserves D4,D7
tile_or_back:
	moveq	#0,d0
	lea		ram_start_8000,a0
	move.b	(a0,d7.w),d0
	cmp.b	#0x24,d0
	jeq		9f						| blank: nothing to OR
	jbsr	tile_get_list
	tst.l	d0
	jmi		9f
	jbsr	tile_locate
	tst.l	d1
	jmi		9f
	move.l	bob_back_screen(pc),a3
	add.l	d1,a3
	lea		(3*NB_BYTES_PER_ROW,a3),a3
	addq.w	#4,a0				| skip char plane
	moveq	#NB_BOBS_PLANES-1,d2
0:
	move.l	(a0)+,d0
	jmi		9f
	jeq		4f
	move.l	d0,a2
	.set	offset,0
	.rept	8
	move.b	(a2)+,d0
	or.b	d0,(offset,a3)
	.set	offset,offset+ILV_STRIDE
	.endr
4:
	lea		(-NB_BYTES_PER_ROW,a3),a3
	dbf		d2,0b
9:
	rts

* apply deferred bob plane tile writes to the back buffer
* (chain complete: level 3 or masked)
flush_deferred_tiles:
	move.w	deferred_count(pc),d6
	jeq		9f
	clr.w	deferred_count
	lea		deferred_tiles,a4
	subq.w	#1,d6
0:
	move.w	(a4)+,d7
	moveq	#0,d0
	lea		ram_start_8000,a0
	move.b	(a0,d7.w),d0		| current value
	jbsr	tile_get_list
	tst.l	d0
	jmi		1f
	jbsr	tile_locate
	tst.l	d1
	jmi		1f
	move.l	bob_back_screen(pc),a1
	add.l	d1,a1
	jbsr	tile_bob_planes_write
1:
	dbf		d6,0b
9:
	rts
* d7=screen address (preserved), d0=tile (preserved)
* should preserve all registers

osd_w_colorram:
    .ifeq OPT_DISABLE_BG_LAYER
	movem.l	d0-d7/a0-a4,-(a7)
	
	
	sub.w	#SCREEN_ADDRESS+0x400,d7
	bcs.b	0f
	cmp.w	#0x400,d7
	bcs.b	1f
0:
	.ifndef		RELEASE

	* should not happen
	lea		write_colorram_out_of_range_error(pc),a0
	jbsr	osd_break
	nop	
	.endif
	bra.b	0f
	
1:
	lea		o_bg_colorram_8400(a6),a1
	add.w	d7,a1
*   we have to force the rewrite
*	cmp.b	(a1),d0
*	beq.b	0f		| already the proper value
*3:
*
	move.b	d0,(a1)	| update logical grid

	jbsr		update_bg_color
0:
	movem.l	(a7)+,d0-d7/a0-a4
    .endif | OPT_DISABLE_BG_LAYER
	rts

compute_tile_xy:
	cmp.w	#0x3C0,d7
	bcc.b	0f
	cmp.w	#0x40,d7
	bcs.b	2f
	
	move.w	d7,d3
	and.w	#0x1F,d3	| this is Y (tile)
	addq	#1,d3
	
	lsr.w	#5,d7		| this is X (tile)
	not.w	d7
	add.w	#0x21,d7
	bra.b	1f
	* two first rows are special
0:
	move.w	d7,d3
	lsr.w	#5,d3		| this is Y
	
	sub.w	#30,d3		| minus 2
	and.w	#0x1F,d7	| this is X
	neg.w	d7
	add.w	#32,d7
	bra.b	1f
	* two last rows as well
2:
	move.w	d7,d3
	lsr.w	#5,d3		| this is Y
	add.w	#33,d3
	and.w	#0x1F,d7	| this is X
	neg.w	d7
	add.w	#32,d7
1:
	rts
	
* d7: screen offset
* d0: tile color code
*

update_bg_color:
	and.w	#0x3F,d0	| mask up to 63
	bsr		compute_tile_xy
	*cmp.w	#(Y_MAX/8)-2,d3
	*jcc		0f				| don't change colors on last rows
	cmp.w	#MAX_ROW_X,d7
	bcc.b	0f				| above 28: ignore
	cmp.w	#2,d7
	bcs.b	0f				| below 2: ignore


	* D3 contains Y row
	lea		bg_color_table(pc),a0
	add.w	d3,d3
	add.w	d3,d3
	move.l	(a0,d3.w),a0
	lea		tile_cluts+2(pc),a1		| skip first color (black)
	lsl.w	#3,d0
	* set color on that row
	move.w	(4,a1,d0.w),(2,a0)
	move.w	(2,a1,d0.w),(6,a0)
	move.w	(a1,d0.w),(10,a0)
0:
	rts
	

set_namco_rows_red:
	move.w	d0,-(a7)
	* restore red color entries
	lea		red_rows,a0
	move.w	#start_color,d0
	move.w	d0,(a0)
	addq.w	#8,d0
	move.w	d0,(4,a0)
	addq.w	#8,d0
	move.w	d0,(8,a0)
	
	move.w	#0x1FE,d0
	lea		color_row_31,a0
	* remove color entries
	move.w	d0,(a0)
	move.w	d0,(4,a0)
	move.w	d0,(8,a0)
	lea		color_row_32,a0
	move.w	d0,(a0)
	move.w	d0,(4,a0)
	move.w	d0,(8,a0)
	move.w	(a7)+,d0
	rts
	
reset_namco_rows:
	move.w	d0,-(a7)

	* remove color entries
	lea		red_rows,a0
	move.w	#0x1FE,d0
	move.w	d0,(a0)
	move.w	d0,(4,a0)
	move.w	d0,(8,a0)
	
	move.w	#start_color,d0
	lea		color_row_31,a0
	* restore color entries
	move.w	d0,(a0)
	addq.w	#8,d0
	move.w	d0,(4,a0)
	addq.w	#8,d0
	move.w	d0,(8,a0)
	move.w	#start_color,d0
	lea		color_row_32,a0
	move.w	d0,(a0)
	addq.w	#8,d0
	move.w	d0,(4,a0)
	addq.w	#8,d0
	move.w	d0,(8,a0)
	move.w	(a7)+,d0

	rts
				
store_sprite_pos_16:
	move.l	a1,-(a7)
	lea		HW_SpriteYTable_16,a1
	bsr		store_sprite_pos
	move.l	(a7)+,a1
	rts
	
*store_sprite_pos_32:
*	move.l	a1,-(a7)
*	lea		HW_SpriteYTable_32,a1
*	bsr		store_sprite_pos
*	move.l	(a7)+,a1
*	rts
	
* < d0.w: x
* < d1.w: y
* < a1: sprite pos table (depending on height)
* > d0.L: control word
store_sprite_pos:
	tst.w	d1
	jmi	0f
	cmp.w	#Y_MAX,d1
	jcc	0f

    move.l  a0,-(a7)

    lea	HW_SpriteXTable(pc),a0
	
	.ifdef	NO68020
    add.w	d0,d0
    add.w	d0,d0
    move.l	(a0,d0.w),d0
	move.w	d1,-(a7)
    add.w	d1,d1
    add.w	d1,d1
    or.l	(a1,d1.w),d0
	move.w	(a7)+,d1
	.else
    move.l	(a0,d0.w*4),d0
    or.l	(a1,d1.w*4),d0	
	.endc
    move.l  (a7)+,a0
    rts
0:
	moveq	#0,d0
	rts
	
	
HW_SpriteXTable:
	.set	reptn,0
	.rept 320
	.set	x,reptn+0x80
	.set reptn,reptn+1
    .byte  0,x>>1,0,x&1
  .endr

	.macro DEF_HW_SPRITE_Y_TABLE	height
HW_SpriteYTable_\height:
  .set	reptn,0
  .rept Y_MAX
	.set	ys,reptn+0x1c
	.set	ye,ys+\height
    .byte  ys&255, 0, ye&255, ((ys>>6)&4)+((ye>>7)&2)
	.set	reptn,reptn+1
  .endr
	.endm


	DEF_HW_SPRITE_Y_TABLE	0
	DEF_HW_SPRITE_Y_TABLE	8
	DEF_HW_SPRITE_Y_TABLE	16



osd_debug_hook:
	rts
	
osd_get_random:
* > D0: pseudo random value (8 bits, all other bits zeroed)
	movem.l	a0,-(a7)
	lea	seed(pc),a0
	move.l	(a0),d0
	* thanks meynaf
	mulu #0xa57b,d0
	addi.l #0xbb40e62d,d0
	rol.l #6,d0	
	move.l	d0,(a0) 
	movem.l	(a7)+,a0
	add.b	_custom+vposr,d0
	and.l	#0xFF,d0
	rts
seed:
	dc.l	0x12345678

	
BIT_LEFT = 3
BIT_RIGHT = 1
BIT_FIRE = 4

* < *A0: number of credits
* < *A0+1: player 1 controls

osd_update_inputs:
	movem.l	a1/d0-d4,-(a7)
	lea		keyboard_table(pc),a1
	move.l	_joypad_state(pc),d1
	move.l	_previous_joypad_state(pc),d2
	st		d0		| active low
	* misc control keys

	tst.b	(5,a1)		| "5" key like in MAME
	beq.b	0f
	bset	#JPB_BTN_REVERSE,d1
0:
	tst.b	(1,a1)		| "1" key like in MAME
	beq.b	0f
	bset	#JPB_BTN_FORWARD,d1
0:
	tst.b	(2,a1)		| "2" key like in MAME
	beq.b	0f
	bset	#JPB_BTN_GRN,d1
0:	


	cmp.b	#3,o_b8_game_state_9201(a6)
	beq.b	2f
	btst	#JPB_BTN_RED,d1
	beq.b	2f
	btst	#JPB_BTN_RED,d2
	bne.b	2f
	* game not in play, accept insert coin with fire	
	bset	#JPB_BTN_REVERSE,d1		| add one credit
2:	
	btst	#JPB_BTN_UP,d1
	beq.b	1f
	btst	#JPB_BTN_UP,d2
	bne.b	1f
	bset	#JPB_BTN_FORWARD,d1		| start 1P game
	

1:
	btst	#JPB_BTN_FORWARD,d1
	beq.b	0f
	btst	#JPB_BTN_FORWARD,d2
	bne.b	0f
	clr		d3
	add.b	d3,d3	| clear X
	move.b	(a0),d3
	beq.b	0f
	moveq	#1,d4
	sbcd	d4,d3		| sub one credit: this starts 1P game
	move.b	d3,(a0)     | as game monitors previous credit count
0:

	btst	#JPB_BTN_GRN,d1
	beq.b	0f
	btst	#JPB_BTN_GRN,d2
	bne.b	0f
	clr		d3
	add.b	d3,d3	| clear X
	move.b	(a0),d3
	moveq	#2,d4
	cmp.b	d4,d3
	bcs.b	0f
	sbcd	d4,d3		| sub one credit: this starts 2P game
	move.b	d3,(a0)     | as game monitors previous credit count
0:

	btst	#JPB_BTN_REVERSE,d1
	beq.b	0f
	btst	#JPB_BTN_REVERSE,d2
	bne.b	0f
	clr		d3
	add.b	d3,d3	| clear X
	move.b	(a0),d3
	moveq	#1,d4
	abcd	d4,d3		| add one credit
	move.b	d3,(a0)
	move.l	d0,-(a7)
	move.w	#CREDIT_SND,d0
	jbsr	osd_sound_start
	move.l	(a7)+,d0
0:
	tst.b	(0x4F,a1)		| "<-" key
	beq.b	0f
	bclr	#BIT_LEFT,d0
0:
	tst.b	(0x4E,a1)		| "->" key
	beq.b	0f
	bclr	#BIT_RIGHT,d0
0:
	tst.b	(0x63,a1)		| "ctrl" key
	beq.b	0f
	bset	#JPB_BTN_RED,d1		| previous inputs
	bra.b	1f
0:
	btst	#JPB_BTN_RED,d1
	beq.b	0f
1:
	btst	#JPB_BTN_RED,d2
	bne.b	0f			        | debounce
	bclr	#BIT_FIRE,d0
0:
	btst	#JPB_BTN_LEFT,d1
	beq.b	0f
	bclr	#BIT_LEFT,d0
0:
	btst	#JPB_BTN_RIGHT,d1
	beq.b	0f
	bclr	#BIT_RIGHT,d0
0:
	
	move.b	d0,(1,a0)
	
	move.l	d1,_previous_joypad_state
	
	movem.l	(a7)+,a1/d0-d4
	rts
	
	
	
osd_read_dsw_1:
	move.b	#3,d0

	rts

osd_read_dsw_2:
*    0x00  = 0 -> A (MEDIUM)
*    0x01  = 1 -> C (HARD)
*    0x02  = 2 -> D (HARDEST)
*    0x03  = 3 -> A (EASY)

	moveq	#3,d0
	rts
	
osd_read_dsw_3:
	moveq	#0,d0
	rts
	

	
osd_read_dsw_6:
	moveq	#0,d0
	rts



osd_read_nb_fighters:
	move.l	dip_switch_start_lives,d0
	move.l	a0,-(a7)
	lea		start_lives_table(pc),a0
	move.b	(a0,d0.w),d0
	move.l	(a7)+,a0
	rts
	
start_lives_table:
	.byte	3-1,2-1,4-1,5-1
	

		
osd_read_high_scores:
	movem.l	d0-d7/a0-a6,-(a7)
	move.l	a0,a4
	move.l	_resload(pc),d0
	beq.b	0f
	move.l	d0,a2
	bsr		get_hiscore_name
 	jsr		resload_GetFileSize(a2)		
	tst.l	d0
	beq.b	2f
	bsr		get_hiscore_name
	lea	o_b_best5_score_8a20(a6),a1
	jsr		resload_LoadFile(a2)		
	bra.b	1f
0:
	tst.b	highscore_loaded
	beq.b	2f
	* from DOS: just copy buffer
	lea		high_score_buffer(pc),a1
	move.w	#SCORE_FILE_SIZE-1,d0
0:
    move.b    (a1)+,(a4)+
	dbf		d0,0b
1:
	* need to update screen 83ED-
	lea		o_b_best5_score1_8a20(a6),a0
	move.w	#0x83F2-5,d7
	moveq	#5,d1
10:
	move.b	(a0)+,d0
	jbsr	osd_w_videoram
	addq.w	#1,d7
	dbf		d1,10b
2:
	movem.l	(a7)+,d0-d7/a0-a6
	rts
	
osd_write_high_scores:
	movem.l	d0-d7/a0-a6,-(a7)
	.ifdef	RELEASE
	tst.b	cheat_used		| don't save score if cheat on
	bne.b	1f
	.endif
	
	move.l	_resload(pc),d0
	beq.b	0f
	move.l	d0,a2
	move.l	#SCORE_FILE_SIZE,d0
	lea		o_b_best5_score_8a20(a6),a1
	bsr		get_hiscore_name
	jsr		resload_SaveFile(a2)
	bra.b	1f
0:
	* from DOS: just copy buffer
	lea		high_score_buffer(pc),a1
	move.w	#SCORE_FILE_SIZE-1,d0
0:
	move.b	(a0)+,(a1)+
	dbf		d0,0b

	st.b	highscore_needs_saving
1:
	movem.l	(a7)+,d0-d7/a0-a6
	rts


level2_interrupt:
	bsr		handle_keyboard
	move.w	#8,_custom+intreq
	rte
	
handle_keyboard:
	movem.l	D0/A0/A5/A6,-(a7)
	lea		ram_start_8000,a6
	LEA	0x00BFD000,A5
	MOVEQ	#0x08,D0
	AND.B	0x1D01(A5),D0
	jeq		1f
	MOVE.B	0x1C01(A5),D0
	NOT.B	D0
	ROR.B	#1,D0		| raw key code here
  
	CLR.B	0x1C01(A5)
  
    lea keyboard_table(pc),a0
    bclr    #7,d0
    seq (a0,d0.w)       | updates keyboard table
    jne   2f     | we don't care about key release
	
    cmp.b   #0x19,d0	| "P" key
    bne.b   0f

    bsr	toggle_pause
0:
	cmp.b	#0x10,d0	| "Q" key (US)
	bne.b	0f
	* game over, no lives + kill mario
	nop
	*clr.b	mario_array_6200
	*move.b	#1,number_of_lives_remaining_6228
0:

	btst	#4,cheat_flags+3
	jeq		10f
	* cheat keys
	cmp.b	#0x50,d0	| F1 key
	bne.b	0f
	move.w	#0x0FF,_custom+color
	eor.b	#1,invincible_flag
	st.b	cheat_used
	
0:
	cmp.b	#0x51,d0	| F2 key
	bne.b	0f
	st.b	cheat_used
	* give double shot
	move.w	#0x0FF,_custom+color
	move.b	#1,o_ds_plyr_actv_9820+_b_2ship(a6)

	
0:
	cmp.b	#0x52,d0	| F3 key
	bne.b	0f
	st.b	cheat_used
	* add 10000+ points
	movem.w	d0/d1,-(a7)
	move.b	#0x90,o_ds_bug_collsn_hit_mult_9290+1(a6)
	movem.w	(a7)+,d0/d1
0:
*	cmp.b	#0x53,d0	| F4 key
*	bne.b	0f
*	st.b	cheat_used
*	* no more enemies => goto next level
*	move.w	#0x0FF,_custom+color
*	clr.b	b_bugs_actv_nbr_92a7
*0:
0:
*	cmp.b	#0x54,d0	| F5 key
*	bne.b	0f
*	st.b	cheat_used
*	move.w	#0x0FF,_custom+color
*0:

10:
	.ifndef	RELEASE
	* cheat but not very rewarding as it kills all lives
	cmp.b	#0x57,d0	| F8 key
	bne.b	0f
	clr.b	o_ds_plyr_actv_9820+_b_nships(a6)
	clr.b	invincible_flag
	move.w	#0x0FF,_custom+color
0:
	cmp.b	#0x58,d0	| F9 key crashes game (restarts whdload)
	bne.b	0f
	illegal
	.endif
0:

	cmp.b	_keyexit,d0	| "ESC" key or whdload quitkey
	bne.b	2f
	BSET	#0x06,0x1E01(A5)
	moveq	#2,d0
	bsr	beamdelay
	BCLR	#0x06,0x1E01(A5)	| acknowledge key
	bra		quit_to_os
2:
	BSET	#0x06,0x1E01(A5)
	moveq	#2,d0
	bsr	beamdelay
	BCLR	#0x06,0x1E01(A5)	| acknowledge key

1:
	movem.l	(a7)+,d0/a0/a5/a6
	rts
	
toggle_pause:
	* pause only within game
	cmp.b	#3,o_b8_game_state_9201(a6)
	bne.b	0f
	eor.b   #1,pause_flag
0:
	rts
	
    
* < D0: numbers of vertical positions to wait
beamdelay:
0:
	move.w  d0,-(a7)
    move.b	0xdff006,d0	| VPOS
1:
	cmp.b	0xdff006,d0
	beq.s	1b
	move.w	(a7)+,d0
	dbf	d0,0b
	rts



	.align	4		| leave this long word alignment
program_args:	ds.l	64,0
program_args_end:
	.long	0		| add a longword else it overwrites the read args string in kick 1.3!
	.align	4
read_args_string:
	.byte	read_args_string_end-read_args_string
	.ascii	"INVINCIBLE/S,INFLIVES/S,PERFECT/S,"
	.ascii	"CHEATKEYS/S,STATICSTARS/S,FORCE25FPS/S,FORCE17FPS/S,STARTLIVES/K/N,STARTLEVEL/K/N"
read_args_string_end:
	.align	2


